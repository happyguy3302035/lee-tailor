<!-- Main Sidebar Container -->
<aside class="main-sidebar sidebar-dark-primary elevation-4">
  <!-- Brand Logo -->
  <a href="/company" class="brand-link">
    <i class="fas fa-layer-group brand-image img-circle elevation-3 text-light pl-2 pr-2" style="opacity: .8; line-height: 1.6;"></i>
    <span class="brand-text font-weight-light"><strong>App Manager</strong></span>
  </a>

  <!-- Sidebar -->
  <div class="sidebar">
    <!-- Sidebar User Panel -->
    <div class="user-panel mt-3 pb-3 mb-3 d-flex align-items-center">
      <div class="image">
        <i class="fas fa-user-circle fa-2x text-light"></i>
      </div>
      <div class="info pl-2">
        <a href="#" class="d-block font-weight-bold">
          <%= (typeof user !== 'undefined' && user && user.username) ? user.username : 'POC-Admin' %>
        </a>
      </div>
    </div>

    <!-- Sidebar Menu -->
    <nav class="mt-2">
      <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
        
        <li class="nav-header">MODULES</li>

        <!-- Company Navigation Link -->
        <li class="nav-item">
          <a href="/company" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'company') ? 'active' : '' %>">
            <i class="nav-icon fas fa-building"></i>
            <p>Company</p>
          </a>
        </li>

        <!-- Client Info -->
        <li class="nav-item">
          <a href="/clientinfo" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'clientinfo') ? 'active' : '' %>">
            <i class="nav-icon fas fa-user-tie"></i>
            <p>Client Info</p>
          </a>
        </li>

        <!-- Order Codes Link -->
        <li class="nav-item">
          <a href="/order-code" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'orderCode') ? 'active' : '' %>">
            <i class="nav-icon fas fa-barcode"></i>
            <p>Order Codes</p>
          </a>
        </li>

        <!-- Components Link -->
        <li class="nav-item">
          <a href="/component" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'component') ? 'active' : '' %>">
            <i class="nav-icon fas fa-cubes"></i>
            <p>Components</p>
          </a>
        </li>

        <!-- Products Link -->
        <li class="nav-item">
          <a href="/product" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'product') ? 'active' : '' %>">
            <i class="nav-icon fas fa-box"></i>
            <p>Products</p>
          </a>
        </li>

        <!-- System Treeview (Parent) -->
        <li class="nav-item <%= (typeof activeParent !== 'undefined' && activeParent === 'system') ? 'menu-open' : '' %>">
          <a href="#" class="nav-link <%= (typeof activeParent !== 'undefined' && activeParent === 'system') ? 'active' : '' %>">
            <i class="nav-icon fas fa-cogs"></i>
            <p>
              System
              <i class="right fas fa-angle-left"></i>
            </p>
          </a>
          <ul class="nav nav-treeview">
            <!-- Factory Sub-item -->
            <li class="nav-item">
              <a href="/factory" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'factory') ? 'active' : '' %>">
                <i class="far fa-circle nav-icon"></i>
                <p>Factory</p>
              </a>
            </li>

            <!-- Transport Sub-item -->
            <li class="nav-item">
              <a href="/transport" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'transport') ? 'active' : '' %>">
                <i class="far fa-circle nav-icon"></i>
                <p>Transport</p>
              </a>
            </li>

          </ul>
        </li>



      </ul>
    </nav>
    <!-- /.sidebar-menu -->
  </div>
  <!-- /.sidebar -->
</aside>
