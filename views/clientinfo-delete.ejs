<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Client Info</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'clientinfo' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">Delete Client</h1>
          </div>
          <div class="col-sm-6 text-right">
            <a href="/clientinfo" class="btn btn-secondary">
              <i class="fas fa-arrow-left mr-1"></i> Back to List
            </a>
          </div>
        </div>
      </div>
    </section>
  
    <section class="content">
      <div class="container-fluid">
        <div class="row justify-content-center">
          <div class="col-md-8">
            <div class="card card-danger shadow-sm">
              <div class="card-header">
                <h3 class="card-title font-weight-bold">
                  <i class="fas fa-exclamation-triangle mr-2"></i> Confirm Deletion
                </h3>
              </div>
              <div class="card-body">
                <p class="lead text-center">Are you sure you want to permanently delete this client record?</p>
                
                <div class="bg-light p-3 rounded border mb-4">
                  <dl class="row mb-0">
                    <dt class="col-sm-4">Client ID:</dt>
                    <dd class="col-sm-8"><%= client.ClientId %></dd>
  
                    <dt class="col-sm-4">Client Name:</dt>
                    <dd class="col-sm-8 font-weight-bold text-danger"><%= client.Name %></dd>
  
                    <dt class="col-sm-4">Short Name:</dt>
                    <dd class="col-sm-8"><%= client.NameShort || '-' %></dd>
  
                    <dt class="col-sm-4">Contact Person:</dt>
                    <dd class="col-sm-8"><%= client.PrimaryContactName || '-' %></dd>
                  </dl>
                </div>
  
                <div class="alert alert-warning mb-0">
                  <i class="fas fa-info-circle mr-1"></i>
                  <strong>Note:</strong> Deleting this client will also automatically remove all associated <strong>ClientAndOrderCode</strong> linkages.
                </div>
              </div>
              
              <div class="card-footer d-flex justify-content-end bg-white border-top">
                <a href="/clientinfo" class="btn btn-default mr-2">Cancel</a>
                <form action="/clientinfo/delete/<%= client.ClientId %>" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-danger px-4">
                    <i class="fas fa-trash-alt mr-1"></i> Confirm Delete
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/js/jquery.overlayScrollbars.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>


</body>
</html>
