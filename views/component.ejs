<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Components</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'component' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <!-- Content Header -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0"><i class="fas fa-cubes mr-2"></i>Components</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="/company">Home</a></li>
              <li class="breadcrumb-item active">Components</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <section class="content">
      <div class="container-fluid">

        <!-- Flash Messages -->
        <% if (typeof message !== 'undefined' && message === 'created') { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="icon fas fa-check"></i> Component created successfully!
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } else if (typeof message !== 'undefined' && message === 'updated') { %>
          <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="icon fas fa-info-circle"></i> Component updated successfully!
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } else if (typeof message !== 'undefined' && message === 'deleted') { %>
          <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="icon fas fa-trash"></i> Component deleted successfully.
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="icon fas fa-exclamation-triangle"></i> <%= error %>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>

        <!-- Table Card -->
        <div class="card card-outline card-primary">
          <div class="card-header">
            <h3 class="card-title"><i class="fas fa-list mr-1"></i> Component List</h3>
            <div class="card-tools">
              <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addModal">
                <i class="fas fa-plus mr-1"></i> Add Component
              </button>
            </div>
          </div>

          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped table-hover mb-0">
                <thead>
                  <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Short Name</th>
                    <th>Chinese Name (CHS)</th>
                    <th>English Name (ENG)</th>
                    <th style="width: 100px;">Priority</th>
                    <th>Remark</th>
                    <th style="width: 160px;" class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (components && components.length > 0) { %>
                    <% components.forEach(function(item) { %>
                      <tr>
                        <td><%= item.ComponentId %></td>
                        <td><span class="badge badge-secondary"><%= item.NameShort %></span></td>
                        <td><strong><%= item.NameCHS %></strong></td>
                        <td><%= item.NameENG %></td>
                        <td>
                          <span class="badge badge-info"><%= item.Priority !== null ? item.Priority : 'N/A' %></span>
                        </td>
                        <td><%= item.Remark || '-' %></td>
                        <td class="text-center">
                          <button 
                            class="btn btn-sm btn-info edit-btn"
                            data-id="<%= item.ComponentId %>"
                            data-namechs="<%= item.NameCHS %>"
                            data-nameeng="<%= item.NameENG %>"
                            data-nameshort="<%= item.NameShort %>"
                            data-priority="<%= item.Priority !== null ? item.Priority : '' %>"
                            data-remark="<%= item.Remark || '' %>"
                          >
                            <i class="fas fa-edit"></i> Edit
                          </button>
                          
                          <button 
                            class="btn btn-sm btn-danger delete-btn"
                            data-id="<%= item.ComponentId %>"
                            data-name="<%= item.NameCHS %> (<%= item.NameENG %>)"
                          >
                            <i class="fas fa-trash"></i> Delete
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" class="text-center text-muted py-4">No Components found. Click "Add Component" to create one.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </section>
  </div>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Modal: Add Component -->
<div class="modal fade" id="addModal" tabindex="-1" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <form action="/component/add" method="POST" class="needs-validation" novalidate>
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="addModalLabel"><i class="fas fa-plus-circle mr-1"></i> Add Component</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-md-4 form-group">
              <label for="addNameShort">Short Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addNameShort" name="NameShort" placeholder="e.g. CPU" required>
              <div class="invalid-feedback">Short Name is required.</div>
            </div>
            <div class="col-md-4 form-group">
              <label for="addNameCHS">Chinese Name (CHS) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addNameCHS" name="NameCHS" placeholder="e.g. 中央处理器" required>
              <div class="invalid-feedback">Chinese Name is required.</div>
            </div>
            <div class="col-md-4 form-group">
              <label for="addNameENG">English Name (ENG) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addNameENG" name="NameENG" placeholder="e.g. Central Processing Unit" required>
              <div class="invalid-feedback">English Name is required.</div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 form-group">
              <label for="addPriority">Priority (Integer)</label>
              <input type="number" class="form-control" id="addPriority" name="Priority" placeholder="e.g. 1" step="1">
            </div>
            <div class="col-md-8 form-group">
              <label for="addRemark">Remark</label>
              <input type="text" class="form-control" id="addRemark" name="Remark" placeholder="Optional notes...">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Edit Component -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <form action="/component/update" method="POST" class="needs-validation" novalidate>
        <div class="modal-header bg-info text-white">
          <h5 class="modal-title" id="editModalLabel"><i class="fas fa-edit mr-1"></i> Edit Component</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="editId" name="ComponentId">
          <div class="row">
            <div class="col-md-4 form-group">
              <label for="editNameShort">Short Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="editNameShort" name="NameShort" required>
              <div class="invalid-feedback">Short Name is required.</div>
            </div>
            <div class="col-md-4 form-group">
              <label for="editNameCHS">Chinese Name (CHS) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="editNameCHS" name="NameCHS" required>
              <div class="invalid-feedback">Chinese Name is required.</div>
            </div>
            <div class="col-md-4 form-group">
              <label for="editNameENG">English Name (ENG) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="editNameENG" name="NameENG" required>
              <div class="invalid-feedback">English Name is required.</div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 form-group">
              <label for="editPriority">Priority (Integer)</label>
              <input type="number" class="form-control" id="editPriority" name="Priority" step="1">
            </div>
            <div class="col-md-8 form-group">
              <label for="editRemark">Remark</label>
              <input type="text" class="form-control" id="editRemark" name="Remark">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info"><i class="fas fa-save mr-1"></i> Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Delete Confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form id="deleteForm" method="POST">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title" id="deleteModalLabel"><i class="fas fa-exclamation-triangle mr-1"></i> Delete Confirmation</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to delete <strong id="deleteItemName"></strong>?</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger"><i class="fas fa-trash mr-1"></i> Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/js/jquery.overlayScrollbars.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

<script>
  $(document).ready(function() {
    // Populate Edit Modal
    $('.edit-btn').on('click', function() {
      const id = $(this).data('id');
      const nameCHS = $(this).data('namechs');
      const nameENG = $(this).data('nameeng');
      const nameShort = $(this).data('nameshort');
      const priority = $(this).data('priority');
      const remark = $(this).data('remark');

      $('#editId').val(id);
      $('#editNameCHS').val(nameCHS);
      $('#editNameENG').val(nameENG);
      $('#editNameShort').val(nameShort);
      $('#editPriority').val(priority);
      $('#editRemark').val(remark);

      $('#editModal').modal('show');
    });

    // Populate Delete Modal
    $('.delete-btn').on('click', function() {
      const id = $(this).data('id');
      const name = $(this).data('name');

      $('#deleteItemName').text(name);
      $('#deleteForm').attr('action', '/component/delete/' + id);

      $('#deleteModal').modal('show');
    });

    // Form Validation logic
    $('.needs-validation').on('submit', function(e) {
      if (!this.checkValidity()) {
        e.preventDefault();
        e.stopPropagation();
      }
      $(this).addClass('was-validated');
    });
  });
</script>

</body>
</html>
