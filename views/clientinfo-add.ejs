<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Client Info</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'clientinfo' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">Add New Client</h1>
          </div>
          <div class="col-sm-6 text-right">
            <a href="/clientinfo" class="btn btn-secondary">
              <i class="fas fa-arrow-left mr-1"></i> Back to List
            </a>
          </div>
        </div>
      </div>
    </section>
  
    <section class="content">
      <div class="container-fluid">
        <form action="/clientinfo/add" method="POST">
          
          <!-- Main Client Details Card -->
          <div class="card card-outline card-success shadow-sm">
            <div class="card-header">
              <h3 class="card-title font-weight-bold">Client Information</h3>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6 form-group">
                  <label for="Name">Client Name <span class="text-danger">*</span></label>
                  <input type="text" id="Name" name="Name" class="form-control" required placeholder="Enter client full name">
                </div>
                <div class="col-md-6 form-group">
                  <label for="NameShort">Short Name</label>
                  <input type="text" id="NameShort" name="NameShort" class="form-control" placeholder="Enter abbreviation or short name">
                </div>
              </div>
  
              <div class="row">
                <div class="col-md-6 form-group">
                  <label for="PrimaryContactName">Primary Contact Name</label>
                  <input type="text" id="PrimaryContactName" name="PrimaryContactName" class="form-control" placeholder="Enter contact person">
                </div>
                <div class="col-md-6 form-group">
                  <label for="Email">Email Address</label>
                  <input type="email" id="Email" name="Email" class="form-control" placeholder="example@domain.com">
                </div>
              </div>
  
              <div class="row">
                <div class="col-md-6 form-group">
                  <label for="Phone">Phone Number</label>
                  <input type="text" id="Phone" name="Phone" class="form-control" placeholder="Enter contact phone">
                </div>
                <div class="col-md-6 form-group">
                  <label for="Address">Address</label>
                  <input type="text" id="Address" name="Address" class="form-control" placeholder="Enter company/client address">
                </div>
              </div>
            </div>
          </div>
  
          <!-- Linkage Panel: ClientAndOrderCode -->
          <div class="card card-outline card-secondary shadow-sm mt-4">
            <div class="card-header">
              <h3 class="card-title font-weight-bold">
                <i class="fas fa-tags mr-1"></i> Link Order Codes
              </h3>
            </div>
            <div class="card-body">
              <div class="row mb-3">
                <div class="col-md-8">
                  <label for="orderCodeSelect" class="small text-muted">Select Order Code</label>
                  <select id="orderCodeSelect" class="form-control">
                    <option value="">-- Choose an Order Code --</option>
                    <% if (typeof availableOrderCodes !== 'undefined' && availableOrderCodes.length > 0) { %>
                      <% availableOrderCodes.forEach(code => { %>
                        <option value="<%= code.OrderCodeId %>" data-label="<%= code.CodeName || code.OrderCodeId %>">
                          <%= code.CodeName || ('Order Code #' + code.OrderCodeId) %>
                        </option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>
                <div class="col-md-4 d-flex align-items-end mt-2 mt-md-0">
                  <button type="button" id="btnAddOrderCode" class="btn btn-success btn-block">
                    <i class="fas fa-plus mr-1"></i> Add Linkage
                  </button>
                </div>
              </div>
  
              <div class="table-responsive">
                <table class="table table-bordered table-striped mb-0">
                  <thead class="thead-light">
                    <tr>
                      <th>Order Code ID</th>
                      <th>Order Code Name / Description</th>
                      <th style="width: 100px;" class="text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody id="linkedOrderCodesList">
                    <tr id="emptyRow">
                      <td colspan="3" class="text-center text-muted py-3">No order codes linked yet.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
  
          <!-- Action Buttons -->
          <div class="d-flex justify-content-end my-4">
            <a href="/clientinfo" class="btn btn-default mr-2">Cancel</a>
            <button type="submit" class="btn btn-success px-4">
              <i class="fas fa-save mr-1"></i> Save Client
            </button>
          </div>
  
        </form>
      </div>
    </section>
  </div>
  
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const selectElem = document.getElementById('orderCodeSelect');
      const btnAdd = document.getElementById('btnAddOrderCode');
      const tbody = document.getElementById('linkedOrderCodesList');
  
      btnAdd.addEventListener('click', function () {
        const selectedValue = selectElem.value;
        if (!selectedValue) return;
  
        const selectedOption = selectElem.options[selectElem.selectedIndex];
        const selectedLabel = selectedOption.getAttribute('data-label');
  
        if (tbody.querySelector(`tr[data-id="${selectedValue}"]`)) {
          alert('This Order Code is already linked.');
          return;
        }
  
        const emptyRow = document.getElementById('emptyRow');
        if (emptyRow) emptyRow.style.display = 'none';
  
        const tr = document.createElement('tr');
        tr.setAttribute('data-id', selectedValue);
        tr.innerHTML = `
          <td>${selectedValue}</td>
          <td>${selectedLabel}</td>
          <td class="text-center">
            <input type="hidden" name="orderCodeIds[]" value="${selectedValue}">
            <button type="button" class="btn btn-xs btn-danger remove-code-btn">
              <i class="fas fa-trash"></i>
            </button>
          </td>
        `;
  
        tbody.appendChild(tr);
        selectElem.value = '';
      });
  
      tbody.addEventListener('click', function (e) {
        const btn = e.target.closest('.remove-code-btn');
        if (btn) {
          btn.closest('tr').remove();
          const remainingRows = tbody.querySelectorAll('tr:not(#emptyRow)');
          if (remainingRows.length === 0) {
            const emptyRow = document.getElementById('emptyRow');
            if (emptyRow) emptyRow.style.display = '';
          }
        }
      });
    });
  </script>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/js/jquery.overlayScrollbars.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>


</body>
</html>
