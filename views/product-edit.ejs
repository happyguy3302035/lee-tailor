<!-- Modal: Edit Product -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <form action="/product/update" method="POST" class="needs-validation" novalidate>
        <div class="modal-header bg-info text-white">
          <h5 class="modal-title" id="editModalLabel"><i class="fas fa-edit mr-1"></i> Edit Product</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="editId" name="ProductId">
          <div class="row">
            <div class="col-md-4 form-group">
              <label for="editNameShort">Short Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="editNameShort" name="NameShort" required>
              <div class="invalid-feedback">Short Name is required.</div>
            </div>
            <div class="col-md-4 form-group">
              <label for="editNameCHS">Chinese Name (CHS) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="editNameCHS" name="NameCHS" required>
              <div class="invalid-feedback">Chinese Name is required.</div>
            </div>
            <div class="col-md-4 form-group">
              <label for="editNameENG">English Name (ENG) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="editNameENG" name="NameENG" required>
              <div class="invalid-feedback">English Name is required.</div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-3 form-group">
              <label for="editPriority">Priority (Integer)</label>
              <input type="number" class="form-control" id="editPriority" name="Priority" step="1">
            </div>
            <div class="col-md-3 form-group">
              <label for="editReportPriority">Report Priority</label>
              <input type="number" class="form-control" id="editReportPriority" name="ReportPriority" step="1">
            </div>
            <div class="col-md-6 form-group">
              <label for="editRemark">Remark</label>
              <input type="text" class="form-control" id="editRemark" name="Remark">
            </div>
          </div>

          <!-- ProductComponent Panel -->
          <div class="card card-outline card-secondary mt-3">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-puzzle-piece mr-1"></i> Product Component Panel</h3>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-9 form-group mb-2">
                  <select class="form-control" id="addComponentSelectEdit">
                    <option value="" disabled selected>-- Select Component --</option>
                    <% if (typeof components !== 'undefined' && components.length > 0) { %>
                      <% components.forEach(function(comp) { %>
                        <option 
                          value="<%= comp.ComponentId %>"
                          data-namechs="<%= comp.NameCHS %>"
                          data-nameeng="<%= comp.NameENG %>"
                          data-nameshort="<%= comp.NameShort %>"
                        >
                          <%= comp.NameCHS %>
                        </option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>
                <div class="col-md-3 form-group mb-2">
                  <button type="button" class="btn btn-outline-primary btn-block" id="addComponentBtnEdit">
                    <i class="fas fa-plus"></i> Add
                  </button>
                </div>
              </div>

              <!-- Linked Components Listbox -->
              <div class="table-responsive border rounded mt-2" style="max-height: 200px; overflow-y: auto;">
                <table class="table table-sm table-hover mb-0">
                  <thead class="thead-light">
                    <tr>
                      <th>Component (CHS)</th>
                      <th>Component (ENG)</th>
                      <th>Short Name</th>
                      <th style="width: 50px;" class="text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody id="componentListEdit">
                    <!-- Dynamic rows populate here -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info"><i class="fas fa-save mr-1"></i> Update</button>
        </div>
      </form>
    </div>
  </div>
</div>
