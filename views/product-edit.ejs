<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Edit Product</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'product' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <!-- Content Header -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0"><i class="fas fa-edit mr-2"></i>Edit Product</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="/company">Home</a></li>
              <li class="breadcrumb-item"><a href="/product">Products</a></li>
              <li class="breadcrumb-item active">Edit Product</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <section class="content">
      <div class="container-fluid">

        <!-- Error Alert -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="icon fas fa-exclamation-triangle"></i> <%= error %>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>

        <form action="/product/edit/<%= product.ProductId %>" method="POST" class="needs-validation" novalidate>
          <input type="hidden" name="ProductId" value="<%= product.ProductId %>">
          
          <!-- Product Information Card -->
          <div class="card card-outline card-info">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-info-circle mr-1"></i> Product Details (ID: <%= product.ProductId %>)</h3>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-4 form-group">
                  <label for="editNameShort">Short Name <span class="text-danger">*</span></label>
                  <input 
                    type="text" 
                    class="form-control" 
                    id="editNameShort" 
                    name="NameShort" 
                    value="<%= product.NameShort %>" 
                    required
                  >
                  <div class="invalid-feedback">Short Name is required.</div>
                </div>

                <div class="col-md-4 form-group">
                  <label for="editNameCHS">Chinese Name (CHS) <span class="text-danger">*</span></label>
                  <input 
                    type="text" 
                    class="form-control" 
                    id="editNameCHS" 
                    name="NameCHS" 
                    value="<%= product.NameCHS %>" 
                    required
                  >
                  <div class="invalid-feedback">Chinese Name is required.</div>
                </div>

                <div class="col-md-4 form-group">
                  <label for="editNameENG">English Name (ENG) <span class="text-danger">*</span></label>
                  <input 
                    type="text" 
                    class="form-control" 
                    id="editNameENG" 
                    name="NameENG" 
                    value="<%= product.NameENG %>" 
                    required
                  >
                  <div class="invalid-feedback">English Name is required.</div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-3 form-group">
                  <label for="editPriority">Priority (Integer)</label>
                  <input 
                    type="number" 
                    class="form-control" 
                    id="editPriority" 
                    name="Priority" 
                    value="<%= product.Priority !== null ? product.Priority : '' %>" 
                    step="1"
                  >
                </div>

                <div class="col-md-3 form-group">
                  <label for="editReportPriority">Report Priority</label>
                  <input 
                    type="number" 
                    class="form-control" 
                    id="editReportPriority" 
                    name="ReportPriority" 
                    value="<%= product.ReportPriority !== null ? product.ReportPriority : '' %>" 
                    step="1"
                  >
                </div>

                <div class="col-md-6 form-group">
                  <label for="editRemark">Remark</label>
                  <input 
                    type="text" 
                    class="form-control" 
                    id="editRemark" 
                    name="Remark" 
                    value="<%= product.Remark || '' %>"
                  >
                </div>
              </div>
            </div>
          </div>

          <!-- Product Component Panel Card -->
<!-- TEMPORARY DEBUG BOX -->
<div class="alert alert-dark text-monospace">
  <h5><i class="fas fa-bug"></i> EJS Debug Info</h5>
  <p><strong>components count:</strong> <%= typeof components !== 'undefined' ? components.length : 'UNDEFINED' %></p>
  <p><strong>selectedComponentIds:</strong> <%= typeof selectedComponentIds !== 'undefined' ? JSON.stringify(selectedComponentIds) : 'UNDEFINED' %></p>
</div>
          <div class="card card-outline card-secondary">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-puzzle-piece mr-1"></i> Product Components</h3>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-9 form-group mb-2">
                  <select class="form-control" id="addComponentSelect">
                    <option value="" disabled selected>-- Select Component to Link --</option>
                    <% if (typeof components !== 'undefined' && components.length > 0) { %>
                      <% components.forEach(function(comp) { %>
                        <option 
                          value="<%= comp.ComponentId %>"
                          data-namechs="<%= comp.NameCHS %>"
                          data-nameeng="<%= comp.NameENG %>"
                          data-nameshort="<%= comp.NameShort %>"
                        >
                          <%= comp.NameCHS %> (<%= comp.NameENG %>)
                        </option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>
                <div class="col-md-3 form-group mb-2">
                  <button type="button" class="btn btn-outline-primary btn-block" id="addComponentBtn">
                    <i class="fas fa-plus"></i> Add Component
                  </button>
                </div>
              </div>

              <!-- Linked Components Table -->
              <div class="table-responsive border rounded mt-3" style="max-height: 250px; overflow-y: auto;">
                <table class="table table-sm table-hover mb-0">
                  <thead class="thead-light">
                    <tr>
                      <th>Component (CHS)</th>
                      <th>Component (ENG)</th>
                      <th>Short Name</th>
                      <th style="width: 80px;" class="text-center">Action</th>
                    </tr>
                  </thead>
<tbody id="componentList">
  <% 
    // Filter components whose ComponentId exists in selectedComponentIds
    let linkedList = [];
    if (typeof components !== 'undefined' && typeof selectedComponentIds !== 'undefined' && selectedComponentIds.length > 0) {
      linkedList = components.filter(comp => 
        selectedComponentIds.some(id => String(id) === String(comp.ComponentId))
      );
    }
  %>

  <% if (linkedList.length > 0) { %>
    <% linkedList.forEach(function(comp) { %>
      <tr data-id="<%= comp.ComponentId %>">
        <td>
          <input type="hidden" name="ComponentIds" value="<%= comp.ComponentId %>">
          <strong><%= comp.NameCHS %></strong>
        </td>
        <td><%= comp.NameENG %></td>
        <td><span class="badge badge-secondary"><%= comp.NameShort %></span></td>
        <td class="text-center">
          <button type="button" class="btn btn-xs btn-danger remove-component-btn">
            <i class="fas fa-times"></i>
          </button>
        </td>
      </tr>
    <% }); %>
  <% } else { %>
    <tr id="emptyComponentRow">
      <td colspan="4" class="text-center text-muted py-3">No components currently linked to this product.</td>
    </tr>
  <% } %>
</tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Form Actions Footer -->
          <div class="card-footer bg-white border-top mb-4 text-right">
            <a href="/product" class="btn btn-secondary mr-2">
              <i class="fas fa-arrow-left mr-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-info">
              <i class="fas fa-save mr-1"></i> Update Product
            </button>
          </div>

        </form>

      </div>
    </section>
  </div>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Core Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/js/jquery.overlayScrollbars.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

<script>
  $(document).ready(function() {

    // Helper to toggle empty placeholder row visibility
    function checkEmptyState() {
      if ($('#componentList tr[data-id]').length === 0) {
        if ($('#emptyComponentRow').length === 0) {
          $('#componentList').append(`
            <tr id="emptyComponentRow">
              <td colspan="4" class="text-center text-muted py-3">No components linked to this product yet.</td>
            </tr>
          `);
        } else {
          $('#emptyComponentRow').show();
        }
      } else {
        $('#emptyComponentRow').hide();
      }
    }

    // Bootstrap validation handler
    const forms = document.getElementsByClassName('needs-validation');
    Array.prototype.filter.call(forms, function(form) {
      form.addEventListener('submit', function(event) {
        if (form.checkValidity() === false) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });

    // Dynamic Component Add Handler
    $('#addComponentBtn').on('click', function() {
      const select = $('#addComponentSelect');
      const selectedOption = select.find('option:selected');
      const componentId = select.val();

      if (!componentId) {
        alert('Please select a component first.');
        return;
      }

      // Prevent adding duplicate components
      if ($(`#componentList tr[data-id="${componentId}"]`).length > 0) {
        alert('This component is already linked to this product.');
        return;
      }

      const nameCHS = selectedOption.data('namechs');
      const nameENG = selectedOption.data('nameeng');
      const nameShort = selectedOption.data('nameshort');

      // Append row with hidden input array entry
      const newRow = `
        <tr data-id="${componentId}">
          <td>
            <input type="hidden" name="ComponentIds[]" value="${componentId}">
            <strong>${nameCHS}</strong>
          </td>
          <td>${nameENG}</td>
          <td><span class="badge badge-secondary">${nameShort}</span></td>
          <td class="text-center">
            <button type="button" class="btn btn-xs btn-danger remove-component-btn">
              <i class="fas fa-times"></i>
            </button>
          </td>
        </tr>
      `;

      $('#componentList').append(newRow);
      checkEmptyState();

      // Reset dropdown select
      select.val('');
    });

    // Remove Component Row Handler
    $(document).on('click', '.remove-component-btn', function() {
      $(this).closest('tr').remove();
      checkEmptyState();
    });

  });
</script>

</body>
</html>
