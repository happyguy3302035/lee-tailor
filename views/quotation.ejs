<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>報價單公司資料設定 - LTMS 管理系統</title>
  
  <!-- Link to static styles in /public/css/styles.css -->
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <div class="app-layout">
    
    <!-- 1. Server-Rendered Shared Menu Partial -->
    <%- include('partials/sidebar', { activePage: activePage }) %>

    <!-- 2. Main Page Content -->
    <main class="main-wrapper">
      
      <!-- Top Header -->
      <header class="page-header">
        <div class="header-title">
          <h1>報價單公司資料設定</h1>
          <p class="subtitle">管理報價單抬頭、聯絡資訊與預設條款</p>
        </div>
        <div class="user-profile">
          <span>使用者: <strong><%= user ? user.username : 'Admin' %></strong></span>
        </div>
      </header>

      <!-- Main Form / Content Container -->
      <section class="content-body">
        <div class="card">
          <div class="card-header">
            <h2>公司抬頭資訊</h2>
          </div>
          
          <div class="card-content">
            <form id="quotation-settings-form" action="/api/quotation-settings" method="POST">
              
              <div class="form-grid">
                <div class="form-group">
                  <label for="companyName">公司名稱 (中文)</label>
                  <input type="text" id="companyName" name="companyName" class="form-control" placeholder="請輸入公司名稱" required>
                </div>

                <div class="form-group">
                  <label for="companyNameEn">公司名稱 (英文)</label>
                  <input type="text" id="companyNameEn" name="companyNameEn" class="form-control" placeholder="Enter Company Name in English">
                </div>

                <div class="form-group">
                  <label for="phone">聯絡電話</label>
                  <input type="tel" id="phone" name="phone" class="form-control" placeholder="+852 1234 5678">
                </div>

                <div class="form-group">
                  <label for="email">電子郵件</label>
                  <input type="email" id="email" name="email" class="form-control" placeholder="info@company.com">
                </div>

                <div class="form-group full-width">
                  <label for="address">公司地址</label>
                  <input type="text" id="address" name="address" class="form-control" placeholder="請輸入完整公司地址">
                </div>

                <div class="form-group full-width">
                  <label for="terms">報價單預設條款 (Terms & Conditions)</label>
                  <textarea id="terms" name="terms" rows="5" class="form-control" placeholder="請輸入預設條款內容..."></textarea>
                </div>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn btn-primary">儲存設定</button>
                <button type="reset" class="btn btn-secondary">重設</button>
              </div>

            </form>
          </div>
        </div>
      </section>

    </main>

  </div>

  <!-- Frontend Logic Script -->
  <script>
    document.getElementById('quotation-settings-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/quotation-settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json();
        
        if (response.ok) {
          alert('公司資料已順利更新！');
        } else {
          alert('更新失敗: ' + result.message);
        }
      } catch (err) {
        console.error('Error submitting form:', err);
        alert('發送請求失敗，請檢查網路連線。');
      }
    });
  </script>

</body>
</html>
