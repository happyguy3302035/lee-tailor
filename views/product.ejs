<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Products</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'product' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <!-- Content Header -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0"><i class="fas fa-box mr-2"></i>Products</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="/company">Home</a></li>
              <li class="breadcrumb-item active">Products</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <section class="content">
      <div class="container-fluid">

        <!-- Flash Messages -->
        <% if (typeof message !== 'undefined' && message === 'created') { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="icon fas fa-check"></i> Product created successfully!
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } else if (typeof message !== 'undefined' && message === 'updated') { %>
          <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="icon fas fa-info-circle"></i> Product updated successfully!
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } else if (typeof message !== 'undefined' && message === 'deleted') { %>
          <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="icon fas fa-trash"></i> Product deleted successfully.
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="icon fas fa-exclamation-triangle"></i> <%= error %>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>

        <!-- Table Card -->
        <div class="card card-outline card-primary">
          <div class="card-header">
            <h3 class="card-title"><i class="fas fa-list mr-1"></i> Product List</h3>
            <div class="card-tools">
              <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addModal">
                <i class="fas fa-plus mr-1"></i> Add Product
              </button>
            </div>
          </div>

          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped table-hover mb-0">
                <thead>
                  <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Short Name</th>
                    <th>Chinese Name (CHS)</th>
                    <th>English Name (ENG)</th>
                    <th style="width: 100px;">Priority</th>
                    <th style="width: 130px;">Report Priority</th>
                    <th>Remark</th>
                    <th style="width: 160px;" class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (products && products.length > 0) { %>
                    <% products.forEach(function(item) { %>
                      <tr>
                        <td><%= item.ProductId %></td>
                        <td><span class="badge badge-secondary"><%= item.NameShort %></span></td>
                        <td><strong><%= item.NameCHS %></strong></td>
                        <td><%= item.NameENG %></td>
                        <td>
                          <span class="badge badge-info"><%= item.Priority !== null ? item.Priority : 'N/A' %></span>
                        </td>
                        <td>
                          <span class="badge badge-purple" style="background-color: #6f42c1; color: #fff;">
                            <%= item.ReportPriority !== null ? item.ReportPriority : 'N/A' %>
                          </span>
                        </td>
                        <td><%= item.Remark || '-' %></td>
                        <td class="text-center">
                          <button 
                            class="btn btn-sm btn-info edit-btn"
                            data-id="<%= item.ProductId %>"
                            data-namechs="<%= item.NameCHS %>"
                            data-nameeng="<%= item.NameENG %>"
                            data-nameshort="<%= item.NameShort %>"
                            data-priority="<%= item.Priority !== null ? item.Priority : '' %>"
                            data-reportpriority="<%= item.ReportPriority !== null ? item.ReportPriority : '' %>"
                            data-remark="<%= item.Remark || '' %>"
                            data-components='<%= JSON.stringify(item.Components || []) %>'
                          >
                            <i class="fas fa-edit"></i> Edit
                          </button>
                          
                          <button 
                            class="btn btn-sm btn-danger delete-btn"
                            data-id="<%= item.ProductId %>"
                            data-name="<%= item.NameCHS %> (<%= item.NameENG %>)"
                          >
                            <i class="fas fa-trash"></i> Delete
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="8" class="text-center text-muted py-4">No Products found. Click "Add Product" to create one.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </section>
  </div>

  <!-- Modal Partials -->
  <%- include('partials/product-add', { components: components }) %>
  <%- include('partials/product-edit', { components: components }) %>
  <%- include('partials/product-delete') %>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Core Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/js/jquery.overlayScrollbars.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

<script>
  $(document).ready(function() {
    // Helper function to append a item to a ProductComponent table/list
    function appendComponentRow(targetTableBody, componentId, nameCHS, nameENG, nameShort) {
      // Avoid adding duplicates
      if (targetTableBody.find(`tr[data-id="${componentId}"]`).length > 0) {
        return;
      }

      const rowHtml = `
        <tr data-id="${componentId}">
          <td>
            ${nameCHS}
            <input type="hidden" name="componentIds[]" value="${componentId}">
          </td>
          <td>${nameENG}</td>
          <td><span class="badge badge-secondary">${nameShort}</span></td>
          <td class="text-center">
            <button type="button" class="btn btn-xs btn-outline-danger remove-component-btn">
              <i class="fas fa-times"></i>
            </button>
          </td>
        </tr>
      `;
      targetTableBody.append(rowHtml);
    }

    // Add Component button handler (ADD Modal)
    $('#addComponentBtnAdd').on('click', function() {
      const select = $('#addComponentSelectAdd option:selected');
      const componentId = select.val();
      if (!componentId) return;

      const nameCHS = select.data('namechs');
      const nameENG = select.data('nameeng');
      const nameShort = select.data('nameshort');

      appendComponentRow($('#componentListAdd'), componentId, nameCHS, nameENG, nameShort);
    });

    // Add Component button handler (EDIT Modal)
    $('#addComponentBtnEdit').on('click', function() {
      const select = $('#addComponentSelectEdit option:selected');
      const componentId = select.val();
      if (!componentId) return;

      const nameCHS = select.data('namechs');
      const nameENG = select.data('nameeng');
      const nameShort = select.data('nameshort');

      appendComponentRow($('#componentListEdit'), componentId, nameCHS, nameENG, nameShort);
    });

    // Remove Component from list item
    $(document).on('click', '.remove-component-btn', function() {
      $(this).closest('tr').remove();
    });

    // Populate Edit Modal
    $('.edit-btn').on('click', function() {
      const id = $(this).data('id');
      const nameCHS = $(this).data('namechs');
      const nameENG = $(this).data('nameeng');
      const nameShort = $(this).data('nameshort');
      const priority = $(this).data('priority');
      const reportPriority = $(this).data('reportpriority');
      const remark = $(this).data('remark');
      const linkedComponents = $(this).data('components') || [];

      $('#editId').val(id);
      $('#editNameCHS').val(nameCHS);
      $('#editNameENG').val(nameENG);
      $('#editNameShort').val(nameShort);
      $('#editPriority').val(priority);
      $('#editReportPriority').val(reportPriority);
      $('#editRemark').val(remark);

      // Render existing ProductComponents
      const listEdit = $('#componentListEdit');
      listEdit.empty();
      linkedComponents.forEach(comp => {
        appendComponentRow(listEdit, comp.ComponentId, comp.NameCHS, comp.NameENG, comp.NameShort);
      });

      $('#editModal').modal('show');
    });

    // Populate Delete Modal
    $('.delete-btn').on('click', function() {
      const id = $(this).data('id');
      const name = $(this).data('name');

      $('#deleteItemName').text(name);
      $('#deleteForm').attr('action', '/product/delete/' + id);

      $('#deleteModal').modal('show');
    });

    // Reset Add modal form on close
    $('#addModal').on('hidden.bs.modal', function () {
      $(this).find('form')[0].reset();
      $('#componentListAdd').empty();
      $(this).find('form').removeClass('was-validated');
    });

    // Client-side HTML5 validation trigger
    $('.needs-validation').on('submit', function(e) {
      if (!this.checkValidity()) {
        e.preventDefault();
        e.stopPropagation();
      }
      $(this).addClass('was-validated');
    });
  });
</script>

</body>
</html>
