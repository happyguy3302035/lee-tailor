<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Client Info</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'clientinfo' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">Edit Client #<%= client.ClientId %></h1>
          </div>
          <div class="col-sm-6 text-right">
            <a href="/clientinfo" class="btn btn-secondary">
              <i class="fas fa-arrow-left mr-1"></i> Back to List
            </a>
          </div>
        </div>
      </div>
    </section>
  
    <section class="content">
      <div class="container-fluid">
        <form action="/clientinfo/edit/<%= client.ClientId %>" method="POST">
          
          <!-- Main Client Details Card -->
          <div class="card card-outline card-info shadow-sm">
            <div class="card-header">
              <h3 class="card-title font-weight-bold">Client Details</h3>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6 form-group">
                  <label for="Name">Client Name <span class="text-danger">*</span></label>
                  <input type="text" id="Name" name="Name" class="form-control" value="<%= client.Name %>" required>
                </div>
                <div class="col-md-6 form-group">
                  <label for="NameShort">Short Name</label>
                  <input type="text" id="NameShort" name="NameShort" class="form-control" value="<%= client.NameShort || '' %>">
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 form-group">
                  <label for="Address">Address</label>
                  <input type="text" id="Address" name="Address" class="form-control" value="<%= client.Address || '' %>" placeholder="Enter company/client address">
                </div>
              </div>

              <hr>
              <h5 class="text-muted mb-3"><i class="fas fa-user-tag mr-1"></i> Primary Contact</h5>
              <div class="row">
                <div class="col-md-6 form-group">
                  <label for="PrimaryContactName">Contact Name</label>
                  <input type="text" id="PrimaryContactName" name="PrimaryContactName" class="form-control" value="<%= client.PrimaryContactName || '' %>" placeholder="Enter primary contact name">
                </div>
                <div class="col-md-6 form-group">
                  <label for="PrimaryContactEmail">Email Address</label>
                  <input type="email" id="PrimaryContactEmail" name="PrimaryContactEmail" class="form-control" value="<%= client.PrimaryContactEmail || '' %>" placeholder="primary@example.com">
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 form-group">
                  <label for="PrimaryContactTel">Telephone</label>
                  <input type="text" id="PrimaryContactTel" name="PrimaryContactTel" class="form-control" value="<%= client.PrimaryContactTel || '' %>" placeholder="Phone number">
                </div>
                <div class="col-md-6 form-group">
                  <label for="PrimaryContactFax">Fax</label>
                  <input type="text" id="PrimaryContactFax" name="PrimaryContactFax" class="form-control" value="<%= client.PrimaryContactFax || '' %>" placeholder="Fax number">
                </div>
              </div>

              <hr>
              <h5 class="text-muted mb-3"><i class="fas fa-user-friends mr-1"></i> Secondary Contact (Optional)</h5>
              <div class="row">
                <div class="col-md-6 form-group">
                  <label for="SecondaryContactName">Contact Name</label>
                  <input type="text" id="SecondaryContactName" name="SecondaryContactName" class="form-control" value="<%= client.SecondaryContactName || '' %>" placeholder="Enter secondary contact name">
                </div>
                <div class="col-md-6 form-group">
                  <label for="SecondaryContactEmail">Email Address</label>
                  <input type="email" id="SecondaryContactEmail" name="SecondaryContactEmail" class="form-control" value="<%= client.SecondaryContactEmail || '' %>" placeholder="secondary@example.com">
                </div>
              </div>
  
              <div class="row">
                <div class="col-md-6 form-group">
                  <label for="SecondaryContactTel">Telephone</label>
                  <input type="text" id="SecondaryContactTel" name="SecondaryContactTel" class="form-control" value="<%= client.SecondaryContactTel || '' %>" placeholder="Phone number">
                </div>
                <div class="col-md-6 form-group">
                  <label for="SecondaryContactFax">Fax</label>
                  <input type="text" id="SecondaryContactFax" name="SecondaryContactFax" class="form-control" value="<%= client.SecondaryContactFax || '' %>" placeholder="Fax number">
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 form-group">
                  <label for="Remark">Remarks / Notes</label>
                  <textarea id="Remark" name="Remark" class="form-control" rows="2" placeholder="Additional details or remarks..."><%= client.Remark || '' %></textarea>
                </div>
              </div>
            </div>
          </div>
  
          <!-- Linkage Panel: ClientAndOrderCode -->
          <div class="card card-outline card-secondary shadow-sm mt-4">
            <div class="card-header">
              <h3 class="card-title font-weight-bold">
                <i class="fas fa-tags mr-1"></i> Linked Order Codes
              </h3>
            </div>
            <div class="card-body">
              <div class="row mb-3">
                <div class="col-md-8">
                  <label for="orderCodeSelect" class="small text-muted">Select Order Code</label>
                  <select id="orderCodeSelect" class="form-control">
                    <option value="">-- Choose an Order Code --</option>
                    <% if (typeof availableOrderCodes !== 'undefined' && availableOrderCodes.length > 0) { %>
                      <% availableOrderCodes.forEach(code => { %>
                        <option value="<%= code.OrderCodeId %>" data-label="<%= code.Name || ('Order Code #' + code.OrderCodeId) %>">
                          <%= code.Name || ('Order Code #' + code.OrderCodeId) %>
                        </option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>
                <div class="col-md-4 d-flex align-items-end mt-2 mt-md-0">
                  <button type="button" id="btnAddOrderCode" class="btn btn-success btn-block">
                    <i class="fas fa-plus mr-1"></i> Add Linkage
                  </button>
                </div>
              </div>
  
              <div class="table-responsive">
                <table class="table table-bordered table-striped mb-0">
                  <thead class="thead-light">
                    <tr>
                      <th>Order Code ID</th>
                      <th>Order Code Name / Description</th>
                      <th style="width: 100px;" class="text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody id="linkedOrderCodesList">
                    <% if (typeof linkedOrderCodes !== 'undefined' && linkedOrderCodes.length > 0) { %>
                      <% linkedOrderCodes.forEach(item => { %>
                        <tr data-id="<%= item.OrderCodeId %>">
                          <td><%= item.OrderCodeId %></td>
                          <td><%= item.Name || ('Order Code #' + item.OrderCodeId) %></td>
                          <td class="text-center">
                            <input type="hidden" name="orderCodeIds[]" value="<%= item.OrderCodeId %>">
                            <button type="button" class="btn btn-xs btn-danger remove-code-btn">
                              <i class="fas fa-trash"></i>
                            </button>
                          </td>
                        </tr>
                      <% }); %>
                    <% } else { %>
                      <tr id="emptyRow">
                        <td colspan="3" class="text-center text-muted py-3">No order codes linked yet.</td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
  
          <!-- Action Buttons -->
          <div class="d-flex justify-content-end my-4">
            <a href="/clientinfo" class="btn btn-default mr-2">Cancel</a>
            <button type="submit" class="btn btn-info px-4">
              <i class="fas fa-save mr-1"></i> Update Client
            </button>
          </div>
  
        </form>
      </div>
    </section>
  </div>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Page-specific dynamic linkage script -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const selectElem = document.getElementById('orderCodeSelect');
    const btnAdd = document.getElementById('btnAddOrderCode');
    const tbody = document.getElementById('linkedOrderCodesList');

    if (btnAdd) {
      btnAdd.addEventListener('click', function () {
        const selectedValue = selectElem.value;
        if (!selectedValue) return;

        const selectedOption = selectElem.options[selectElem.selectedIndex];
        const selectedLabel = selectedOption.getAttribute('data-label');

        if (tbody.querySelector(`tr[data-id="${selectedValue}"]`)) {
          alert('This Order Code is already linked.');
          return;
        }

        const emptyRow = document.getElementById('emptyRow');
        if (emptyRow) emptyRow.style.display = 'none';

        const tr = document.createElement('tr');
        tr.setAttribute('data-id', selectedValue);
        tr.innerHTML = `
          <td>${selectedValue}</td>
          <td>${selectedLabel}</td>
          <td class="text-center">
            <input type="hidden" name="orderCodeIds[]" value="${selectedValue}">
            <button type="button" class="btn btn-xs btn-danger remove-code-btn">
              <i class="fas fa-trash"></i>
            </button>
          </td>
        `;

        tbody.appendChild(tr);
        selectElem.value = '';
      });
    }

    if (tbody) {
      tbody.addEventListener('click', function (e) {
        const btn = e.target.closest('.remove-code-btn');
        if (btn) {
          btn.closest('tr').remove();
          const remainingRows = tbody.querySelectorAll('tr:not(#emptyRow)');
          if (remainingRows.length === 0) {
            const emptyRow = document.getElementById('emptyRow');
            if (emptyRow) emptyRow.style.display = '';
          }
        }
      });
    }
  });
</script>

</body>
</html>
