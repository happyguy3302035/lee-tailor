<div class="card card-outline card-primary shadow-sm">
  <div class="card-header border-0 d-flex flex-wrap align-items-center justify-content-between">
    <h3 class="card-title font-weight-bold">Client Directory</h3>

    <!-- Search Form -->
    <div class="card-tools">
      <form action="/clientinfo" method="GET" class="form-inline">
        <input type="hidden" name="limit" value="<%= pagination.limit %>">
        <input type="hidden" name="sortBy" value="<%= sorting.sortBy %>">
        <input type="hidden" name="sortDir" value="<%= sorting.sortDir %>">

        <div class="input-group input-group-sm" style="width: 250px;">
          <input 
            type="text" 
            name="search" 
            class="form-control" 
            placeholder="Search by client name..." 
            value="<%= searchQuery %>"
          >
          <div class="input-group-append">
            <% if (searchQuery) { %>
              <a href="/clientinfo?limit=<%= pagination.limit %>" class="btn btn-default" title="Clear">
                <i class="fas fa-times text-danger"></i>
              </a>
            <% } %>
            <button type="submit" class="btn btn-default">
              <i class="fas fa-search"></i>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Table View -->
  <div class="card-body table-responsive p-0">
    <table class="table table-hover table-striped text-nowrap align-middle mb-0">
      <thead class="thead-light">
        <tr>
          <% 
            // Helper for sorting headers
            function buildSortUrl(col) {
              const newDir = (sorting.sortBy === col && sorting.sortDir === 'ASC') ? 'DESC' : 'ASC';
              return `/clientinfo?search=${encodeURIComponent(searchQuery)}&page=1&limit=${pagination.limit}&sortBy=${col}&sortDir=${newDir}`;
            }

            function renderSortIcon(col) {
              if (sorting.sortBy !== col) return '<i class="fas fa-sort text-muted ml-1"></i>';
              return sorting.sortDir === 'ASC' 
                ? '<i class="fas fa-sort-up text-primary ml-1"></i>' 
                : '<i class="fas fa-sort-down text-primary ml-1"></i>';
            }
          %>
          <th><a href="<%= buildSortUrl('ClientId') %>" class="text-dark">ID <%- renderSortIcon('ClientId') %></a></th>
          <th><a href="<%= buildSortUrl('Name') %>" class="text-dark">Client Name <%- renderSortIcon('Name') %></a></th>
          <th><a href="<%= buildSortUrl('NameShort') %>" class="text-dark">Short Name <%- renderSortIcon('NameShort') %></a></th>
          <th><a href="<%= buildSortUrl('PrimaryContactName') %>" class="text-dark">Contact Person <%- renderSortIcon('PrimaryContactName') %></a></th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (clients.length > 0) { %>
          <% clients.forEach(client => { %>
            <tr>
              <td class="align-middle"><%= client.ClientId %></td>
              <td class="align-middle font-weight-bold"><%= client.Name %></td>
              <td class="align-middle"><%= client.NameShort || '-' %></td>
              <td class="align-middle"><%= client.PrimaryContactName || '-' %></td>
              <td class="text-right align-middle">
                <a href="/clientinfo/edit/<%= client.ClientId %>" class="btn btn-sm btn-outline-info mr-1">
                  <i class="fas fa-edit"></i> Edit
                </a>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center text-muted py-4">No records found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination & Controls Footer -->
  <div class="card-footer bg-white border-top d-flex flex-wrap align-items-center justify-content-between py-3">
    
    <!-- Items per Page Selector & Info -->
    <div class="d-flex align-items-center mb-2 mb-md-0">
      <span class="text-muted mr-2 small">Show</span>
      <select 
        class="custom-select custom-select-sm w-auto mr-2" 
        onchange="location = this.value;"
      >
        <% [10, 25, 50, 100].forEach(optionLimit => { %>
          <option 
            value="/clientinfo?search=<%= encodeURIComponent(searchQuery) %>&page=1&limit=<%= optionLimit %>&sortBy=<%= sorting.sortBy %>&sortDir=<%= sorting.sortDir %>"
            <%= pagination.limit === optionLimit ? 'selected' : '' %>
          >
            <%= optionLimit %>
          </option>
        <% }); %>
      </select>
      <span class="text-muted small">
        entries | Showing 
        <strong><%= pagination.totalItems > 0 ? ((pagination.currentPage - 1) * pagination.limit) + 1 : 0 %></strong> 
        to 
        <strong><%= Math.min(pagination.currentPage * pagination.limit, pagination.totalItems) %></strong> 
        of <strong><%= pagination.totalItems %></strong> records
      </span>
    </div>

    <!-- Pagination Navigation -->
    <% if (pagination.totalPages > 1) { %>
      <% 
        function pageUrl(p) {
          return `/clientinfo?search=${encodeURIComponent(searchQuery)}&page=${p}&limit=${pagination.limit}&sortBy=${sorting.sortBy}&sortDir=${sorting.sortDir}`;
        }
      %>
      <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm m-0">
          
          <!-- First Page -->
          <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="<%= pageUrl(1) %>" aria-label="First">
              <i class="fas fa-angle-double-left"></i>
            </a>
          </li>

          <!-- Previous Page -->
          <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="<%= pageUrl(pagination.currentPage - 1) %>" aria-label="Previous">
              <i class="fas fa-angle-left"></i>
            </a>
          </li>

          <!-- Page Numbers with Ellipsis -->
          <% pagination.pageNumbers.forEach(p => { %>
            <% if (p === '...') { %>
              <li class="page-item disabled"><span class="page-link">...</span></li>
            <% } else { %>
              <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                <a class="page-link" href="<%= pageUrl(p) %>"><%= p %></a>
              </li>
            <% } %>
          <% }); %>

          <!-- Next Page -->
          <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="<%= pageUrl(pagination.currentPage + 1) %>" aria-label="Next">
              <i class="fas fa-angle-right"></i>
            </a>
          </li>

          <!-- Last Page -->
          <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="<%= pageUrl(pagination.totalPages) %>" aria-label="Last">
              <i class="fas fa-angle-double-right"></i>
            </a>
          </li>

        </ul>
      </nav>
    <% } %>

  </div>
</div>
