<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Client Info</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'clientinfo' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <!-- Content Header -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0"><i class="fas fa-user-tie mr-2"></i>Client Info</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="/company">Home</a></li>
              <li class="breadcrumb-item active">Client Info</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <section class="content">
      <div class="container-fluid">

        <!-- Flash Alerts -->
        <% if (typeof message !== 'undefined' && message === 'created') { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="icon fas fa-check"></i> Client created successfully!
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } else if (typeof message !== 'undefined' && message === 'updated') { %>
          <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="icon fas fa-info-circle"></i> Client updated successfully!
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } else if (typeof message !== 'undefined' && message === 'deleted') { %>
          <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="icon fas fa-trash"></i> Client deleted.
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="icon fas fa-exclamation-triangle"></i> <%= error %>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>

        <!-- Table Card -->
        <div class="card card-outline card-primary">
          <div class="card-header d-flex align-items-center">
            <h3 class="card-title mb-0">
              <i class="fas fa-list mr-1"></i> Client List 
              <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                <small class="text-muted ml-2">(Filtered: "<strong><%= searchQuery %></strong>")</small>
              <% } %>
            </h3>

            <!-- Header Tools: Inline Search Form & Add Client Button -->
            <div class="card-tools ml-auto d-flex align-items-center">
              <form action="/clientinfo" method="GET" class="form-inline">
                <input type="hidden" name="limit" value="<%= pagination.limit %>">
                <input type="hidden" name="sortBy" value="<%= sorting.sortBy %>">
                <input type="hidden" name="sortDir" value="<%= sorting.sortDir %>">
         
                <div class="input-group input-group-sm" style="width: 250px;">
                  <input 
                    type="text" 
                    name="search" 
                    class="form-control" 
                    placeholder="Search by client name..." 
                    value="<%= searchQuery %>"
                  >
                  <div class="input-group-append">
                    <% if (searchQuery) { %>
                      <a href="/clientinfo?limit=<%= pagination.limit %>" class="btn btn-default" title="Clear">
                        <i class="fas fa-times text-danger"></i>
                      </a>
                    <% } %>
                    <button type="submit" class="btn btn-default">
                      <i class="fas fa-search"></i>
                    </button>
                  </div>
                </div>
              </form>

              <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addModal">
                <i class="fas fa-plus mr-1"></i> Add Client
              </button>
            </div>
          </div>

          <div class="card-body table-responsive p-0">
              <table class="table table-hover table-striped text-nowrap align-middle mb-0">
                <thead class="thead-light">
                  <tr>
                    <% 
                      // Helper for sorting headers
                      function buildSortUrl(col) {
                        const newDir = (sorting.sortBy === col && sorting.sortDir === 'ASC') ? 'DESC' : 'ASC';
                        return `/clientinfo?search=${encodeURIComponent(searchQuery)}&page=1&limit=${pagination.limit}&sortBy=${col}&sortDir=${newDir}`;
                      }
          
                      function renderSortIcon(col) {
                        if (sorting.sortBy !== col) return '<i class="fas fa-sort text-muted ml-1"></i>';
                        return sorting.sortDir === 'ASC' 
                          ? '<i class="fas fa-sort-up text-primary ml-1"></i>' 
                          : '<i class="fas fa-sort-down text-primary ml-1"></i>';
                      }
                    %>
                    <th><a href="<%= buildSortUrl('ClientId') %>" class="text-dark">ID <%- renderSortIcon('ClientId') %></a></th>
                    <th><a href="<%= buildSortUrl('Name') %>" class="text-dark">Client Name <%- renderSortIcon('Name') %></a></th>
                    <th><a href="<%= buildSortUrl('NameShort') %>" class="text-dark">Short Name <%- renderSortIcon('NameShort') %></a></th>
                    <th><a href="<%= buildSortUrl('PrimaryContactName') %>" class="text-dark">Primary Contact Person <%- renderSortIcon('PrimaryContactName') %></a></th>
                    <th>Email / Phone</th>
                    <th>Address</th>
                    <th class="text-right">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (clients && clients.length > 0) { %>
                    <% clients.forEach(function(item) { %>
                      <tr>
                        <td><%= item.ClientId %></td>
                        <td><span class="badge badge-secondary"><%= item.NameShort %></span></td>
                        <td><strong><%= item.Name %></strong></td>
                        <td><%= item.PrimaryContactName || '-' %></td>
                        <td>
                          <% if (item.PrimaryContactEmail) { %>
                            <i class="fas fa-envelope text-muted mr-1"></i><%= item.PrimaryContactEmail %><br>
                          <% } %>
                          <% if (item.PrimaryContactTel) { %>
                            <i class="fas fa-phone text-muted mr-1"></i><%= item.PrimaryContactTel %>
                          <% } %>
                          <% if (!item.PrimaryContactEmail && !item.PrimaryContactTel) { %>-<% } %>
                        </td>
                        <td><%= item.Address || '-' %></td>
                        <td class="text-center">
                          <button 
                            class="btn btn-sm btn-info edit-btn"
                            data-id="<%= item.ClientId %>"
                            data-name="<%= item.Name %>"
                            data-nameshort="<%= item.NameShort %>"
                            data-address="<%= item.Address || '' %>"
                            data-pname="<%= item.PrimaryContactName || '' %>"
                            data-ptel="<%= item.PrimaryContactTel || '' %>"
                            data-pfax="<%= item.PrimaryContactFax || '' %>"
                            data-pemail="<%= item.PrimaryContactEmail || '' %>"
                            data-sname="<%= item.SecondaryContactName || '' %>"
                            data-stel="<%= item.SecondaryContactTel || '' %>"
                            data-sfax="<%= item.SecondaryContactFax || '' %>"
                            data-semail="<%= item.SecondaryContactEmail || '' %>"
                            data-remark="<%= item.Remark || '' %>"
                          >
                            <i class="fas fa-edit"></i> Edit
                          </button>
                          
                          <button 
                            class="btn btn-sm btn-danger delete-btn"
                            data-id="<%= item.ClientId %>"
                            data-name="<%= item.Name %>"
                          >
                            <i class="fas fa-trash"></i> Delete
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" class="text-center text-muted py-4">
                        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                          No clients found matching "<strong><%= searchQuery %></strong>". <a href="/clientinfo">Clear search</a>
                        <% } else { %>
                          No Client Info records found. Click "Add Client" to create one.
                        <% } %>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
            <!-- Pagination & Controls Footer -->
            <div class="card-footer bg-white border-top d-flex flex-wrap align-items-center justify-content-between py-3">
              
              <!-- Items per Page Selector & Info -->
              <div class="d-flex align-items-center mb-2 mb-md-0">
                <span class="text-muted mr-2 small">Show</span>
                <select 
                  class="custom-select custom-select-sm w-auto mr-2" 
                  onchange="location = this.value;"
                >
                  <% [10, 25, 50, 100].forEach(optionLimit => { %>
                    <option 
                      value="/clientinfo?search=<%= encodeURIComponent(searchQuery) %>&page=1&limit=<%= optionLimit %>&sortBy=<%= sorting.sortBy %>&sortDir=<%= sorting.sortDir %>"
                      <%= pagination.limit === optionLimit ? 'selected' : '' %>
                    >
                      <%= optionLimit %>
                    </option>
                  <% }); %>
                </select>
                <span class="text-muted small">
                  entries | Showing 
                  <strong><%= pagination.totalItems > 0 ? ((pagination.currentPage - 1) * pagination.limit) + 1 : 0 %></strong> 
                  to 
                  <strong><%= Math.min(pagination.currentPage * pagination.limit, pagination.totalItems) %></strong> 
                  of <strong><%= pagination.totalItems %></strong> records
                </span>
              </div>
          
              <!-- Pagination Navigation -->
              <% if (pagination.totalPages > 1) { %>
                <% 
                  function pageUrl(p) {
                    return `/clientinfo?search=${encodeURIComponent(searchQuery)}&page=${p}&limit=${pagination.limit}&sortBy=${sorting.sortBy}&sortDir=${sorting.sortDir}`;
                  }
                %>
                <nav aria-label="Page navigation">
                  <ul class="pagination pagination-sm m-0">
                    
                    <!-- First Page -->
                    <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                      <a class="page-link" href="<%= pageUrl(1) %>" aria-label="First">
                        <i class="fas fa-angle-double-left"></i>
                      </a>
                    </li>
          
                    <!-- Previous Page -->
                    <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                      <a class="page-link" href="<%= pageUrl(pagination.currentPage - 1) %>" aria-label="Previous">
                        <i class="fas fa-angle-left"></i>
                      </a>
                    </li>
          
                    <!-- Page Numbers with Ellipsis -->
                    <% pagination.pageNumbers.forEach(p => { %>
                      <% if (p === '...') { %>
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                      <% } else { %>
                        <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                          <a class="page-link" href="<%= pageUrl(p) %>"><%= p %></a>
                        </li>
                      <% } %>
                    <% }); %>
          
                    <!-- Next Page -->
                    <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                      <a class="page-link" href="<%= pageUrl(pagination.currentPage + 1) %>" aria-label="Next">
                        <i class="fas fa-angle-right"></i>
                      </a>
                    </li>
          
                    <!-- Last Page -->
                    <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                      <a class="page-link" href="<%= pageUrl(pagination.totalPages) %>" aria-label="Last">
                        <i class="fas fa-angle-double-right"></i>
                      </a>
                    </li>
          
                  </ul>
                </nav>
              <% } %>
          
            </div>
          </div>
        </div>

      </div>
    </section>
  </div>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Modal: Add Client -->
<div class="modal fade" id="addModal" tabindex="-1" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <form action="/clientinfo/add" method="POST" class="needs-validation" novalidate>
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="addModalLabel"><i class="fas fa-plus-circle mr-1"></i> Add Client Info</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6 form-group">
              <label for="addName">Client Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addName" name="Name" required>
              <div class="invalid-feedback">Client Name is required.</div>
            </div>
            <div class="col-md-6 form-group">
              <label for="addNameShort">Short Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addNameShort" name="NameShort" required>
              <div class="invalid-feedback">Short Name is required.</div>
            </div>
          </div>
          <div class="form-group">
            <label for="addAddress">Address</label>
            <input type="text" class="form-control" id="addAddress" name="Address">
          </div>

          <hr>
          <h6 class="text-primary font-weight-bold"><i class="fas fa-user mr-1"></i> Primary Contact</h6>
          <div class="row">
            <div class="col-md-6 form-group">
              <label>Name</label>
              <input type="text" class="form-control" name="PrimaryContactName">
            </div>
            <div class="col-md-6 form-group">
              <label>Email</label>
              <input type="email" class="form-control" name="PrimaryContactEmail" placeholder="e.g. contact@domain.com">
              <div class="invalid-feedback">Please provide a valid email address.</div>
            </div>
            <div class="col-md-6 form-group">
              <label>Tel</label>
              <input type="tel" class="form-control" name="PrimaryContactTel" pattern="^[+]?[0-9\s\-\(\)]{7,20}$" placeholder="e.g. +44 20 7946 0912">
              <div class="invalid-feedback">Please enter a valid phone number.</div>
            </div>
            <div class="col-md-6 form-group">
              <label>Fax</label>
              <input type="tel" class="form-control" name="PrimaryContactFax" pattern="^[+]?[0-9\s\-\(\)]{7,20}$" placeholder="e.g. +44 20 7946 0913">
              <div class="invalid-feedback">Please enter a valid fax number.</div>
            </div>
          </div>

          <hr>
          <h6 class="text-secondary font-weight-bold"><i class="fas fa-user-friends mr-1"></i> Secondary Contact</h6>
          <div class="row">
            <div class="col-md-6 form-group">
              <label>Name</label>
              <input type="text" class="form-control" name="SecondaryContactName">
            </div>
            <div class="col-md-6 form-group">
              <label>Email</label>
              <input type="email" class="form-control" name="SecondaryContactEmail" placeholder="e.g. contact2@domain.com">
              <div class="invalid-feedback">Please provide a valid email address.</div>
            </div>
            <div class="col-md-6 form-group">
              <label>Tel</label>
              <input type="tel" class="form-control" name="SecondaryContactTel" pattern="^[+]?[0-9\s\-\(\)]{7,20}$">
              <div class="invalid-feedback">Please enter a valid phone number.</div>
            </div>
            <div class="col-md-6 form-group">
              <label>Fax</label>
              <input type="tel" class="form-control" name="SecondaryContactFax" pattern="^[+]?[0-9\s\-\(\)]{7,20}$">
              <div class="invalid-feedback">Please enter a valid fax number.</div>
            </div>
          </div>

          <hr>
          <div class="form-group">
            <label for="addRemark">Remark</label>
            <textarea class="form-control" id="addRemark" name="Remark" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Edit Client -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <form action="/clientinfo/update" method="POST" class="needs-validation" novalidate>
        <div class="modal-header bg-info text-white">
          <h5 class="modal-title" id="editModalLabel"><i class="fas fa-edit mr-1"></i> Edit Client Info</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="editId" name="ClientId">
          <div class="row">
            <div class="col-md-6 form-group">
              <label for="editName">Client Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="editName" name="Name" required>
              <div class="invalid-feedback">Client Name is required.</div>
            </div>
            <div class="col-md-6 form-group">
              <label for="editNameShort">Short Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="editNameShort" name="NameShort" required>
              <div class="invalid-feedback">Short Name is required.</div>
            </div>
          </div>
          <div class="form-group">
            <label for="editAddress">Address</label>
            <input type="text" class="form-control" id="editAddress" name="Address">
          </div>

          <hr>
          <h6 class="text-info font-weight-bold"><i class="fas fa-user mr-1"></i> Primary Contact</h6>
          <div class="row">
            <div class="col-md-6 form-group">
              <label>Name</label>
              <input type="text" class="form-control" id="editPName" name="PrimaryContactName">
            </div>
            <div class="col-md-6 form-group">
              <label>Email</label>
              <input type="email" class="form-control" id="editPEmail" name="PrimaryContactEmail">
              <div class="invalid-feedback">Please provide a valid email address.</div>
            </div>
            <div class="col-md-6 form-group">
              <label>Tel</label>
              <input type="tel" class="form-control" id="editPTel" name="PrimaryContactTel" pattern="^[+]?[0-9\s\-\(\)]{7,20}$">
              <div class="invalid-feedback">Please enter a valid phone number.</div>
            </div>
            <div class="col-md-6 form-group">
              <label>Fax</label>
              <input type="tel" class="form-control" id="editPFax" name="PrimaryContactFax" pattern="^[+]?[0-9\s\-\(\)]{7,20}$">
              <div class="invalid-feedback">Please enter a valid fax number.</div>
            </div>
          </div>

          <hr>
          <h6 class="text-secondary font-weight-bold"><i class="fas fa-user-friends mr-1"></i> Secondary Contact</h6>
          <div class="row">
            <div class="col-md-6 form-group">
              <label>Name</label>
              <input type="text" class="form-control" id="editSName" name="SecondaryContactName">
            </div>
            <div class="col-md-6 form-group">
              <label>Email</label>
              <input type="email" class="form-control" id="editSEmail" name="SecondaryContactEmail">
              <div class="invalid-feedback">Please provide a valid email address.</div>
            </div>
            <div class="col-md-6 form-group">
              <label>Tel</label>
              <input type="tel" class="form-control" id="editSTel" name="SecondaryContactTel" pattern="^[+]?[0-9\s\-\(\)]{7,20}$">
              <div class="invalid-feedback">Please enter a valid phone number.</div>
            </div>
            <div class="col-md-6 form-group">
              <label>Fax</label>
              <input type="tel" class="form-control" id="editSFax" name="SecondaryContactFax" pattern="^[+]?[0-9\s\-\(\)]{7,20}$">
              <div class="invalid-feedback">Please enter a valid fax number.</div>
            </div>
          </div>

          <hr>
          <div class="form-group">
            <label for="editRemark">Remark</label>
            <textarea class="form-control" id="editRemark" name="Remark" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info"><i class="fas fa-save mr-1"></i> Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Delete Confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form id="deleteForm" method="POST">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title" id="deleteModalLabel"><i class="fas fa-exclamation-triangle mr-1"></i> Delete Confirmation</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to delete <strong id="deleteItemName"></strong>?</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger"><i class="fas fa-trash mr-1"></i> Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/js/jquery.overlayScrollbars.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

<script>
  $(document).ready(function() {
    // Populate Edit Modal
    $('.edit-btn').on('click', function() {
      $('#editId').val($(this).data('id'));
      $('#editName').val($(this).data('name'));
      $('#editNameShort').val($(this).data('nameshort'));
      $('#editAddress').val($(this).data('address'));
      
      $('#editPName').val($(this).data('pname'));
      $('#editPTel').val($(this).data('ptel'));
      $('#editPFax').val($(this).data('pfax'));
      $('#editPEmail').val($(this).data('pemail'));

      $('#editSName').val($(this).data('sname'));
      $('#editSTel').val($(this).data('stel'));
      $('#editSFax').val($(this).data('sfax'));
      $('#editSEmail').val($(this).data('semail'));

      $('#editRemark').val($(this).data('remark'));

      $('#editModal').modal('show');
    });

    // Populate Delete Modal
    $('.delete-btn').on('click', function() {
      const id = $(this).data('id');
      const name = $(this).data('name');

      $('#deleteItemName').text(name);
      $('#deleteForm').attr('action', '/clientinfo/delete/' + id);

      $('#deleteModal').modal('show');
    });

    // Client-side HTML5 / Bootstrap form validation
    $('.needs-validation').on('submit', function(e) {
      if (!this.checkValidity()) {
        e.preventDefault();
        e.stopPropagation();
      }
      $(this).addClass('was-validated');
    });
  });
</script>

</body>
</html>
