<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Client Info</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'clientinfo' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <!-- Content Header -->
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">Client Management</h1>
          </div>
          <div class="col-sm-6 text-right">
            <a href="/clientinfo/add" class="btn btn-primary shadow-sm">
              <i class="fas fa-plus-circle mr-1"></i> Add New Client
            </a>
          </div>
        </div>
      </div>
    </section>
  
    <!-- Main Content -->
    <section class="content">
      <div class="container-fluid">
  
        <!-- Alert Banners -->
        <% if (typeof message !== 'undefined' && message) { %>
          <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="icon fas fa-check mr-2"></i><%= message %>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>
  
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="icon fas fa-ban mr-2"></i><%= error %>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>
  
        <!-- Directory Card -->
        <div class="card card-outline card-primary shadow-sm">
          
          <!-- Header & Search Bar -->
          <div class="card-header border-0 d-flex flex-wrap align-items-center justify-content-between">
            <h3 class="card-title font-weight-bold">Client Directory</h3>
  
            <div class="card-tools">
              <form action="/clientinfo" method="GET" class="form-inline">
                <input type="hidden" name="limit" value="<%= pagination.limit %>">
                <input type="hidden" name="sortBy" value="<%= sorting.sortBy %>">
                <input type="hidden" name="sortDir" value="<%= sorting.sortDir %>">
  
                <div class="input-group input-group-sm" style="width: 280px;">
                  <input 
                    type="text" 
                    name="search" 
                    class="form-control" 
                    placeholder="Search name, contact..." 
                    value="<%= searchQuery %>"
                  >
                  <div class="input-group-append">
                    <% if (searchQuery) { %>
                      <a href="/clientinfo?limit=<%= pagination.limit %>&sortBy=<%= sorting.sortBy %>&sortDir=<%= sorting.sortDir %>" class="btn btn-default" title="Clear Search">
                        <i class="fas fa-times text-danger"></i>
                      </a>
                    <% } %>
                    <button type="submit" class="btn btn-default">
                      <i class="fas fa-search"></i>
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
  
          <!-- Table View -->
          <div class="card-body table-responsive p-0">
            <table class="table table-hover table-striped text-nowrap align-middle mb-0">
              <thead class="thead-light">
                <tr>
                  <% 
                    function buildSortUrl(col) {
                      const newDir = (sorting.sortBy === col && sorting.sortDir === 'ASC') ? 'DESC' : 'ASC';
                      return `/clientinfo?search=${encodeURIComponent(searchQuery)}&page=1&limit=${pagination.limit}&sortBy=${col}&sortDir=${newDir}`;
                    }
  
                    function renderSortIcon(col) {
                      if (sorting.sortBy !== col) return '<i class="fas fa-sort text-muted ml-1"></i>';
                      return sorting.sortDir === 'ASC' 
                        ? '<i class="fas fa-sort-up text-primary ml-1"></i>' 
                        : '<i class="fas fa-sort-down text-primary ml-1"></i>';
                    }
                  %>
                  <th><a href="<%= buildSortUrl('ClientId') %>" class="text-dark text-decoration-none">ID <%- renderSortIcon('ClientId') %></a></th>
                  <th><a href="<%= buildSortUrl('Name') %>" class="text-dark text-decoration-none">Client Name <%- renderSortIcon('Name') %></a></th>
                  <th><a href="<%= buildSortUrl('NameShort') %>" class="text-dark text-decoration-none">Short Name <%- renderSortIcon('NameShort') %></a></th>
                  <th><a href="<%= buildSortUrl('PrimaryContactName') %>" class="text-dark text-decoration-none">Contact Person <%- renderSortIcon('PrimaryContactName') %></a></th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (clients && clients.length > 0) { %>
                  <% clients.forEach(client => { %>
                    <tr>
                      <td class="align-middle"><%= client.ClientId %></td>
                      <td class="align-middle font-weight-bold"><%= client.Name %></td>
                      <td class="align-middle"><%= client.NameShort || '-' %></td>
                      <td class="align-middle"><%= client.PrimaryContactName || '-' %></td>
                      <td class="text-right align-middle">
                        <a href="/clientinfo/edit/<%= client.ClientId %>" class="btn btn-sm btn-outline-info mr-1">
                          <i class="fas fa-edit"></i> Edit
                        </a>
                        <a href="/clientinfo/delete/<%= client.ClientId %>" class="btn btn-sm btn-outline-danger">
                          <i class="fas fa-trash-alt"></i> Delete
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                      <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                      No client records found.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
  
          <!-- Pagination Footer -->
          <div class="card-footer bg-white border-top d-flex flex-wrap align-items-center justify-content-between py-3">
            
            <div class="d-flex align-items-center mb-2 mb-md-0">
              <span class="text-muted mr-2 small">Show</span>
              <select class="custom-select custom-select-sm w-auto mr-2" onchange="location = this.value;">
                <% [10, 25, 50, 100].forEach(optionLimit => { %>
                  <option 
                    value="/clientinfo?search=<%= encodeURIComponent(searchQuery) %>&page=1&limit=<%= optionLimit %>&sortBy=<%= sorting.sortBy %>&sortDir=<%= sorting.sortDir %>"
                    <%= pagination.limit === optionLimit ? 'selected' : '' %>
                  >
                    <%= optionLimit %>
                  </option>
                <% }); %>
              </select>
              <span class="text-muted small">
                entries | Showing 
                <strong><%= pagination.totalItems > 0 ? ((pagination.currentPage - 1) * pagination.limit) + 1 : 0 %></strong> 
                to 
                <strong><%= Math.min(pagination.currentPage * pagination.limit, pagination.totalItems) %></strong> 
                of <strong><%= pagination.totalItems %></strong> records
              </span>
            </div>
  
            <% if (pagination.totalPages > 1) { %>
              <% 
                function pageUrl(p) {
                  return `/clientinfo?search=${encodeURIComponent(searchQuery)}&page=${p}&limit=${pagination.limit}&sortBy=${sorting.sortBy}&sortDir=${sorting.sortDir}`;
                }
              %>
              <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm m-0">
                  <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= pageUrl(1) %>"><i class="fas fa-angle-double-left"></i></a>
                  </li>
                  <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= pageUrl(pagination.currentPage - 1) %>"><i class="fas fa-angle-left"></i></a>
                  </li>
                  <% pagination.pageNumbers.forEach(p => { %>
                    <% if (p === '...') { %>
                      <li class="page-item disabled"><span class="page-link">...</span></li>
                    <% } else { %>
                      <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                        <a class="page-link" href="<%= pageUrl(p) %>"><%= p %></a>
                      </li>
                    <% } %>
                  <% }); %>
                  <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= pageUrl(pagination.currentPage + 1) %>"><i class="fas fa-angle-right"></i></a>
                  </li>
                  <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= pageUrl(pagination.totalPages) %>"><i class="fas fa-angle-double-right"></i></a>
                  </li>
                </ul>
              </nav>
            <% } %>
  
          </div>
        </div>
  
      </div>
    </section>
  </div>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/js/jquery.overlayScrollbars.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

<script>
  $(document).ready(function() {
    // Populate Edit Modal
    $('.edit-btn').on('click', function() {
      $('#editId').val($(this).data('id'));
      $('#editName').val($(this).data('name'));
      $('#editNameShort').val($(this).data('nameshort'));
      $('#editAddress').val($(this).data('address'));
      
      $('#editPName').val($(this).data('pname'));
      $('#editPTel').val($(this).data('ptel'));
      $('#editPFax').val($(this).data('pfax'));
      $('#editPEmail').val($(this).data('pemail'));

      $('#editSName').val($(this).data('sname'));
      $('#editSTel').val($(this).data('stel'));
      $('#editSFax').val($(this).data('sfax'));
      $('#editSEmail').val($(this).data('semail'));

      $('#editRemark').val($(this).data('remark'));

      $('#editModal').modal('show');
    });

    // Populate Delete Modal
    $('.delete-btn').on('click', function() {
      const id = $(this).data('id');
      const name = $(this).data('name');

      $('#deleteItemName').text(name);
      $('#deleteForm').attr('action', '/clientinfo/delete/' + id);

      $('#deleteModal').modal('show');
    });

    // Client-side HTML5 / Bootstrap form validation
    $('.needs-validation').on('submit', function(e) {
      if (!this.checkValidity()) {
        e.preventDefault();
        e.stopPropagation();
      }
      $(this).addClass('was-validated');
    });
  });
</script>

</body>
</html>
