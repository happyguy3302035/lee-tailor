<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Add Client</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'clientinfo' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0 text-dark">Add New Client</h1>
          </div>
          <div class="col-sm-6 text-right">
            <a href="/clientinfo" class="btn btn-secondary">
              <i class="fas fa-arrow-left mr-1"></i> Back to List
            </a>
          </div>
        </div>
      </div>
    </section>
  
    <section class="content">
      <div class="container-fluid">
      <form action="/product/add" method="POST" class="needs-validation" novalidate>
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="addModalLabel"><i class="fas fa-plus-circle mr-1"></i> Add Product</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-md-4 form-group">
              <label for="addNameShort">Short Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addNameShort" name="NameShort" placeholder="e.g. SUIT" required>
              <div class="invalid-feedback">Short Name is required.</div>
            </div>
            <div class="col-md-4 form-group">
              <label for="addNameCHS">Chinese Name (CHS) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addNameCHS" name="NameCHS" placeholder="e.g. 西装" required>
              <div class="invalid-feedback">Chinese Name is required.</div>
            </div>
            <div class="col-md-4 form-group">
              <label for="addNameENG">English Name (ENG) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="addNameENG" name="NameENG" placeholder="e.g. Suit" required>
              <div class="invalid-feedback">English Name is required.</div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-3 form-group">
              <label for="addPriority">Priority (Integer)</label>
              <input type="number" class="form-control" id="addPriority" name="Priority" placeholder="e.g. 1" step="1">
            </div>
            <div class="col-md-3 form-group">
              <label for="addReportPriority">Report Priority</label>
              <input type="number" class="form-control" id="addReportPriority" name="ReportPriority" placeholder="e.g. 1" step="1">
            </div>
            <div class="col-md-6 form-group">
              <label for="addRemark">Remark</label>
              <input type="text" class="form-control" id="addRemark" name="Remark" placeholder="Optional notes...">
            </div>
          </div>

          <!-- ProductComponent Panel -->
          <div class="card card-outline card-secondary mt-3">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-puzzle-piece mr-1"></i> Product Component Panel</h3>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-9 form-group mb-2">
                  <select class="form-control" id="addComponentSelectAdd">
                    <option value="" disabled selected>-- Select Component --</option>
                    <% if (typeof components !== 'undefined' && components.length > 0) { %>
                      <% components.forEach(function(comp) { %>
                        <option 
                          value="<%= comp.ComponentId %>"
                          data-namechs="<%= comp.NameCHS %>"
                          data-nameeng="<%= comp.NameENG %>"
                          data-nameshort="<%= comp.NameShort %>"
                        >
                          <%= comp.NameCHS %>
                        </option>
                      <% }); %>
                    <% } %>
                  </select>
                </div>
                <div class="col-md-3 form-group mb-2">
                  <button type="button" class="btn btn-outline-primary btn-block" id="addComponentBtnAdd">
                    <i class="fas fa-plus"></i> Add
                  </button>
                </div>
              </div>

              <!-- Linked Components Listbox -->
              <div class="table-responsive border rounded mt-2" style="max-height: 200px; overflow-y: auto;">
                <table class="table table-sm table-hover mb-0">
                  <thead class="thead-light">
                    <tr>
                      <th>Component (CHS)</th>
                      <th>Component (ENG)</th>
                      <th>Short Name</th>
                      <th style="width: 50px;" class="text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody id="componentListAdd">
                    <!-- Dynamic rows append here -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save</button>
        </div>
      </form>
      </div>
    </section>
  </div>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Page-specific dynamic linkage script -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const selectElem = document.getElementById('componentSelect');
    const btnAdd = document.getElementById('btnAddComponent');
    const tbody = document.getElementById('linkedComponentsList');

    if (btnAdd) {
      btnAdd.addEventListener('click', function () {
        const selectedValue = selectElem.value; 
        if (!selectedValue) return;

        const selectedOption = selectElem.options[selectElem.selectedIndex];
        const selectedLabel = selectedOption.getAttribute('data-label'); 

        if (tbody.querySelector(`tr[data-id="${selectedValue}"]`)) {
          alert('This Order Code is already linked.');
          return;
        }

        // Hide "No order codes linked" row
        const emptyRow = document.getElementById('emptyRow');
        if (emptyRow) emptyRow.style.display = 'none';

        // Add row to table
        const tr = document.createElement('tr');
        tr.setAttribute('data-id', selectedValue);
        tr.innerHTML = `
          <td>${selectedValue}</td>
          <td>${selectedLabel}</td>
          <td class="text-center">

            <input type="hidden" name="ComponentIds[]" value="${selectedValue}">
            <button type="button" class="btn btn-xs btn-danger remove-code-btn">
              <i class="fas fa-trash"></i>
            </button>
          </td>
        `;

        tbody.appendChild(tr);
        selectElem.value = '';
      });
    }

    if (tbody) {
      tbody.addEventListener('click', function (e) {
        const btn = e.target.closest('.remove-code-btn');
        if (btn) {
          btn.closest('tr').remove();
          const remainingRows = tbody.querySelectorAll('tr:not(#emptyRow)');
          if (remainingRows.length === 0) {
            const emptyRow = document.getElementById('emptyRow');
            if (emptyRow) emptyRow.style.display = '';
          }
        }
      });
    }
  });
</script>

</body>
</html>
