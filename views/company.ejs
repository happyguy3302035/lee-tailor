<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Company Management</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'company' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <!-- Content Header -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0"><i class="fas fa-building mr-2"></i>Company Management</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="/company">Home</a></li>
              <li class="breadcrumb-item active">Company</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">
        
        <!-- Metrics Row -->
        <div class="row">
          <div class="col-12 col-sm-6 col-md-3">
            <div class="info-box mb-3">
              <span class="info-box-icon bg-info elevation-1"><i class="fas fa-building"></i></span>
              <div class="info-box-content">
                <span class="info-box-text">Total Companies</span>
                <span class="info-box-number" id="totalCompaniesCount">
                  <%= (typeof companies !== 'undefined' && companies) ? companies.length : 0 %>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Data Card -->
        <div class="card card-primary card-outline">
          <div class="card-header">
            <h3 class="card-title">Company List</h3>
            <div class="card-tools d-flex align-items-center">
              <button type="button" class="btn btn-primary btn-sm mr-2" data-toggle="modal" data-target="#addCompanyModal">
                <i class="fas fa-plus mr-1"></i> Add Company
              </button>
            </div>
          </div>

          <div class="card-body table-responsive p-0">
            <table class="table table-hover table-striped text-nowrap align-middle">
              <thead>
                <tr>
                  <th style="width: 60px;">ID</th>
                  <th>公司名稱 (Name)</th>
                  <th>電郵 (Email)</th>
                  <th>電話 (Phone)</th>
                  <th>手機 (Mobile)</th>
                  <th>傳真 (Fax)</th>
                  <th>地址</th>
                  <th style="width: 120px;" class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody id="companyTableBody">
                <% if (typeof companies !== 'undefined' && companies && companies.length > 0) { %>
                  <% companies.forEach(function(comp) { %>
                    <tr>
                      <td><%= comp.id %></td>
                      <td><strong><%= comp.Name || comp.name || 'N/A' %></strong></td>
                      <td><%= comp.Email || comp.email || 'N/A' %></td>
                      <td><%= comp.Phone || comp.phone || 'N/A' %></td>
                      <td><%= comp.Mobile || comp.mobile || 'N/A' %></td>
                      <td><%= comp.Fax || comp.fax || 'N/A' %></td>
                      <td><%= comp.Address || comp.address || 'N/A' %></td>
                      <td class="text-center">
                        <button class="btn btn-info btn-xs mr-1" title="Edit" onclick="editCompany('<%= comp.id %>')">
                          <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-danger btn-xs" title="Delete" onclick="deleteCompany('<%= comp.id %>')">
                          <i class="fas fa-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                      <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                      No companies found in database.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>
  </div>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Modal: Add Company -->
<div class="modal fade" id="addCompanyModal" tabindex="-1" role="dialog" aria-labelledby="addCompanyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="addCompanyModalLabel"><i class="fas fa-plus-circle mr-2"></i>Add New Company</h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form id="addCompanyForm">
        <div class="modal-body">
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="companyName">公司名稱 (Name) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="companyName" name="name" placeholder="Enter company name" required>
            </div>
            <div class="form-group col-md-6">
              <label for="companyEmail">電郵 (Email)</label>
              <input type="email" class="form-control" id="companyEmail" name="email" placeholder="contact@company.com">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group col-md-4">
              <label for="companyPhone">電話 (Phone)</label>
              <input type="tel" class="form-control" id="companyPhone" name="phone" 
                     placeholder="+852 2123 4567"
                     pattern="^[+]?[0-9\s\-\(\)]{7,20}$"
                     title="Please enter a valid international phone format">
            </div>
            <div class="form-group col-md-4">
              <label for="companyMobile">手機 (Mobile)</label>
              <input type="tel" class="form-control" id="companyMobile" name="mobile" 
                     placeholder="+852 9123 4567"
                     pattern="^[+]?[0-9\s\-\(\)]{7,20}$"
                     title="Please enter a valid international mobile format">
            </div>
            <div class="form-group col-md-4">
              <label for="companyFax">傳真 (Fax)</label>
              <input type="tel" class="form-control" id="companyFax" name="fax" 
                     placeholder="+852 2123 4568"
                     pattern="^[+]?[0-9\s\-\(\)]{7,20}$"
                     title="Please enter a valid international fax format">
            </div>
          </div>
          <div class="form-group">
            <label for="companyAddress">地址 (Address)</label>
            <input type="text" class="form-control" id="companyAddress" name="address" placeholder="Company full address">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save Company</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Edit Company -->
<div class="modal fade" id="editCompanyModal" tabindex="-1" role="dialog" aria-labelledby="editCompanyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header bg-info text-white">
        <h5 class="modal-title" id="editCompanyModalLabel"><i class="fas fa-edit mr-2"></i>Edit Company</h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form id="editCompanyForm">
        <input type="hidden" id="editCompanyId">
        <div class="modal-body">
          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="editCompanyName">公司名稱 (Name) <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="editCompanyName" name="name" required>
            </div>
            <div class="form-group col-md-6">
              <label for="editCompanyEmail">電郵 (Email)</label>
              <input type="email" class="form-control" id="editCompanyEmail" name="email">
            </div>
          </div>
          <div class="form-row">
            <div class="form-group col-md-4">
              <label for="editCompanyPhone">電話 (Phone)</label>
              <input type="tel" class="form-control" id="editCompanyPhone" name="phone"
                     pattern="^[+]?[0-9\s\-\(\)]{7,20}$">
            </div>
            <div class="form-group col-md-4">
              <label for="editCompanyMobile">手機 (Mobile)</label>
              <input type="tel" class="form-control" id="editCompanyMobile" name="mobile"
                     pattern="^[+]?[0-9\s\-\(\)]{7,20}$">
            </div>
            <div class="form-group col-md-4">
              <label for="editCompanyFax">傳真 (Fax)</label>
              <input type="tel" class="form-control" id="editCompanyFax" name="fax"
                     pattern="^[+]?[0-9\s\-\(\)]{7,20}$">
            </div>
          </div>
          <div class="form-group">
            <label for="editCompanyAddress">地址 (Address)</label>
            <input type="text" class="form-control" id="editCompanyAddress" name="address">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info"><i class="fas fa-sync-alt mr-1"></i> Update Company</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Required Core Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/js/jquery.overlayScrollbars.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

<script>
  $(document).ready(function() {
    // ------------------------------------------
    // 1. ADD COMPANY FORM SUBMISSION (POST)
    // ------------------------------------------
    $('#addCompanyForm').on('submit', function(e) {
      e.preventDefault();

      const formData = {
        name: $('#companyName').val(),
        email: $('#companyEmail').val(),
        phone: $('#companyPhone').val(),
        mobile: $('#companyMobile').val(),
        fax: $('#companyFax').val(),
        address: $('#companyAddress').val()
      };

      $.ajax({
        url: '/api/company',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(formData),
        success: function(response) {
          if (response.success) {
            $('#addCompanyModal').modal('hide');
            window.location.reload();
          } else {
            alert('Failed to save company: ' + response.message);
          }
        },
        error: function(xhr) {
          const err = xhr.responseJSON ? xhr.responseJSON.message : 'Server error';
          alert('Error saving company: ' + err);
        }
      });
    });

    // ------------------------------------------
    // 2. EDIT COMPANY FORM SUBMISSION (PUT)
    // ------------------------------------------
    $('#editCompanyForm').on('submit', function(e) {
      e.preventDefault();

      const id = $('#editCompanyId').val();
      const formData = {
        name: $('#editCompanyName').val(),
        email: $('#editCompanyEmail').val(),
        phone: $('#editCompanyPhone').val(),
        mobile: $('#editCompanyMobile').val(),
        fax: $('#editCompanyFax').val(),
        address: $('#editCompanyAddress').val()
      };

      $.ajax({
        url: '/api/company/' + id,
        type: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify(formData),
        success: function(response) {
          if (response.success) {
            $('#editCompanyModal').modal('hide');
            window.location.reload();
          } else {
            alert('Failed to update company: ' + response.message);
          }
        },
        error: function(xhr) {
          const err = xhr.responseJSON ? xhr.responseJSON.message : 'Server error';
          alert('Error updating company: ' + err);
        }
      });
    });
  });

  // ------------------------------------------
  // 3. FETCH COMPANY DATA & OPEN EDIT MODAL
  // ------------------------------------------
  function editCompany(id) {
    $.ajax({
      url: '/api/company/' + id,
      type: 'GET',
      success: function(response) {
        if (response.success && response.data) {
          const comp = response.data;
          
          $('#editCompanyId').val(comp.id);
          $('#editCompanyName').val(comp.Name || comp.name || '');
          $('#editCompanyEmail').val(comp.Email || comp.email || '');
          $('#editCompanyPhone').val(comp.Phone || comp.phone || '');
          $('#editCompanyMobile').val(comp.Mobile || comp.mobile || '');
          $('#editCompanyFax').val(comp.Fax || comp.fax || '');
          $('#editCompanyAddress').val(comp.Address || comp.address || '');

          $('#editCompanyModal').modal('show');
        } else {
          alert('Company data could not be retrieved.');
        }
      },
      error: function() {
        alert('Error fetching company details');
      }
    });
  }

  // ------------------------------------------
  // 4. DELETE COMPANY (DELETE)
  // ------------------------------------------
  function deleteCompany(id) {
    if (confirm('Are you sure you want to delete this company?')) {
      $.ajax({
        url: '/api/company/' + id,
        type: 'DELETE',
        success: function(response) {
          if (response.success) {
            window.location.reload();
          } else {
            alert('Failed to delete company: ' + response.message);
          }
        },
        error: function() {
          alert('Error deleting company');
        }
      });
    }
  }
</script>

</body>
</html>
