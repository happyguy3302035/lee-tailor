<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Company Information</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'company' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <!-- Content Header -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0"><i class="fas fa-building mr-2"></i>Company Information</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="/company">Home</a></li>
              <li class="breadcrumb-item active">Company</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">

        <!-- Flash Alert Messages -->
        <% if (message === 'created') { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="icon fas fa-check"></i> Company Information created successfully!
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } else if (message === 'updated') { %>
          <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="icon fas fa-info-circle"></i> Company Information updated successfully!
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>

        <!-- Single Record Form Card -->
        <div class="card card-info card-outline">
          <div class="card-header">
            <h3 class="card-title">
              <i class="fas fa-edit mr-1"></i>
              <%= companyInfo ? 'Edit Company Information' : 'Setup Company Information' %>
            </h3>
          </div>

          <form id="companyForm" action="/company/save" method="POST" class="needs-validation" novalidate>
            <div class="card-body">
              
              <!-- Company Name (Max 100 Chars) -->
              <div class="form-group">
                <label for="Name">Company Name <span class="text-danger">*</span></label>
                <input 
                  type="text" 
                  class="form-control" 
                  id="Name" 
                  name="Name" 
                  placeholder="Enter company name"
                  value="<%= companyInfo ? companyInfo.Name : '' %>" 
                  maxlength="100"
                  required
                >
                <div class="d-flex justify-content-between">
                  <small class="invalid-feedback">Company Name is required (Max 100 characters).</small>
                  <small class="form-text text-muted ml-auto"><span id="nameCharCount">0</span>/100 chars</small>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 form-group">
                  <label for="Email">Email Address</label>
                  <input 
                    type="email" 
                    class="form-control" 
                    id="Email" 
                    name="Email" 
                    placeholder="Enter email address"
                    value="<%= companyInfo ? companyInfo.Email : '' %>"
                  >
                  <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>

                <!-- Phone Field -->
                <div class="col-md-6 form-group">
                  <label for="Phone">Phone Number</label>
                  <input 
                    type="tel" 
                    class="form-control" 
                    id="Phone" 
                    name="Phone" 
                    placeholder="e.g. +44 113 123 4567"
                    value="<%= companyInfo ? companyInfo.Phone : '' %>"
                    pattern="^[+]?[0-9\s\-\(\)]{7,20}$"
                  >
                  <div class="invalid-feedback">Please enter a valid phone number (7–20 digits, spaces, dashes, or parentheses).</div>
                </div>
              </div>

              <div class="row">
                <!-- Mobile Field -->
                <div class="col-md-6 form-group">
                  <label for="Mobile">Mobile Number</label>
                  <input 
                    type="tel" 
                    class="form-control" 
                    id="Mobile" 
                    name="Mobile" 
                    placeholder="e.g. +44 7700 900123"
                    value="<%= companyInfo ? companyInfo.Mobile : '' %>"
                    pattern="^[+]?[0-9\s\-\(\)]{7,20}$"
                  >
                  <div class="invalid-feedback">Please enter a valid mobile number (7–20 digits, spaces, dashes, or parentheses).</div>
                </div>

                <!-- Fax Field -->
                <div class="col-md-6 form-group">
                  <label for="Fax">Fax Number</label>
                  <input 
                    type="tel" 
                    class="form-control" 
                    id="Fax" 
                    name="Fax" 
                    placeholder="e.g. +44 113 123 4568"
                    value="<%= companyInfo ? companyInfo.Fax : '' %>"
                    pattern="^[+]?[0-9\s\-\(\)]{7,20}$"
                  >
                  <div class="invalid-feedback">Please enter a valid fax number (7–20 digits, spaces, dashes, or parentheses).</div>
                </div>
              </div>

              <!-- Address (Max 255 Chars) -->
              <div class="form-group">
                <label for="Address">Company Address</label>
                <textarea 
                  class="form-control" 
                  id="Address" 
                  name="Address" 
                  rows="3" 
                  placeholder="Enter address"
                  maxlength="255"
                ><%= companyInfo ? companyInfo.Address : '' %></textarea>
                <div class="d-flex justify-content-between">
                  <small class="invalid-feedback">Address cannot exceed 255 characters.</small>
                  <small class="form-text text-muted ml-auto"><span id="addressCharCount">0</span>/255 chars</small>
                </div>
              </div>

            </div>

            <div class="card-footer">
              <button type="submit" class="btn btn-info">
                <i class="fas fa-save mr-1"></i>
                <%= companyInfo ? 'Update Company Info' : 'Create Company Info' %>
              </button>
            </div>
          </form>
        </div>

      </div>
    </section>
  </div>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Required Core Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/js/jquery.overlayScrollbars.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

<script>
  $(document).ready(function() {
    // Real-time character counter update function
    function updateCounter(inputSelector, counterSelector) {
      const currentLength = $(inputSelector).val().length;
      $(counterSelector).text(currentLength);
    }

    // Initialize character counts on page load
    updateCounter('#Name', '#nameCharCount');
    updateCounter('#Address', '#addressCharCount');

    // Update counters dynamically on input
    $('#Name').on('input', function() {
      updateCounter('#Name', '#nameCharCount');
    });

    $('#Address').on('input', function() {
      updateCounter('#Address', '#addressCharCount');
    });

    // Bootstrap Form Validation on Submit
    $('#companyForm').on('submit', function(e) {
      const form = this;
      if (!form.checkValidity()) {
        e.preventDefault();
        e.stopPropagation();
      }
      $(form).addClass('was-validated');
    });
  });
</script>

</body>
</html>
