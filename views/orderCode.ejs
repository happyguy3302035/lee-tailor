<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>App Manager | Order Codes</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- OverlayScrollbars -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/css/OverlayScrollbars.min.css">
  <!-- Theme style (AdminLTE 3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar Partial -->
  <%- include('partials/navbar') %>

  <!-- Sidebar Partial -->
  <%- include('partials/sidebar', { activePage: 'orderCode' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <!-- Content Header -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1 class="m-0"><i class="fas fa-barcode mr-2"></i>Order Codes</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="/company">Home</a></li>
              <li class="breadcrumb-item active">Order Codes</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">

        <!-- Flash Messages -->
        <% if (typeof message !== 'undefined' && message === 'created') { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="icon fas fa-check"></i> Order Code added successfully!
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } else if (typeof message !== 'undefined' && message === 'updated') { %>
          <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="icon fas fa-info-circle"></i> Order Code updated successfully!
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } else if (typeof message !== 'undefined' && message === 'deleted') { %>
          <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="icon fas fa-trash"></i> Order Code deleted.
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="icon fas fa-exclamation-triangle"></i> <%= error %>
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
        <% } %>

        <!-- Card Container -->
        <div class="card card-outline card-primary">
          <div class="card-header">
            <h3 class="card-title"><i class="fas fa-list mr-1"></i> Order Code List</h3>
            <div class="card-tools">
              <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addModal">
                <i class="fas fa-plus mr-1"></i> Add Order Code
              </button>
            </div>
          </div>

          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped table-hover mb-0">
                <thead>
                  <tr>
                    <th style="width: 100px;">ID</th>
                    <th>Name</th>
                    <th style="width: 150px;">Priority</th>
                    <th style="width: 160px;" class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (orderCodes && orderCodes.length > 0) { %>
                    <% orderCodes.forEach(function(item) { %>
                      <tr>
                        <td><%= item.OrderCodeId %></td>
                        <td><strong><%= item.Name %></strong></td>
                        <td>
                          <span class="badge badge-info"><%= item.Priority !== null ? item.Priority : 'N/A' %></span>
                        </td>
                        <td class="text-center">
                          <button 
                            class="btn btn-sm btn-info edit-btn"
                            data-id="<%= item.OrderCodeId %>"
                            data-name="<%= item.Name %>"
                            data-priority="<%= item.Priority !== null ? item.Priority : '' %>"
                          >
                            <i class="fas fa-edit"></i> Edit
                          </button>
                          
                          <button 
                            class="btn btn-sm btn-danger delete-btn"
                            data-id="<%= item.OrderCodeId %>"
                            data-name="<%= item.Name %>"
                          >
                            <i class="fas fa-trash"></i> Delete
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="4" class="text-center text-muted py-4">No Order Codes found. Click "Add Order Code" to create one.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </section>
  </div>

  <!-- Footer Partial -->
  <%- include('partials/footer') %>

</div>

<!-- Modal: Add Order Code -->
<div class="modal fade" id="addModal" tabindex="-1" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form action="/order-code/add" method="POST" class="needs-validation" novalidate>
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="addModalLabel"><i class="fas fa-plus-circle mr-1"></i> Add Order Code</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label for="addName">Name <span class="text-danger">*</span></label>
            <input 
              type="text" 
              class="form-control" 
              id="addName" 
              name="Name" 
              placeholder="e.g. URGENT, NORMAL, EXPRESS"
              maxlength="100" 
              required
            >
            <div class="invalid-feedback">Name is required (Max 100 characters).</div>
          </div>
          <div class="form-group">
            <label for="addPriority">Priority (Integer)</label>
            <input 
              type="number" 
              class="form-control" 
              id="addPriority" 
              name="Priority" 
              placeholder="e.g. 1, 2, 3" 
              step="1"
            >
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Edit Order Code -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form action="/order-code/update" method="POST" class="needs-validation" novalidate>
        <div class="modal-header bg-info text-white">
          <h5 class="modal-title" id="editModalLabel"><i class="fas fa-edit mr-1"></i> Edit Order Code</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="editId" name="OrderCodeId">
          <div class="form-group">
            <label for="editName">Name <span class="text-danger">*</span></label>
            <input 
              type="text" 
              class="form-control" 
              id="editName" 
              name="Name" 
              maxlength="100" 
              required
            >
            <div class="invalid-feedback">Name is required (Max 100 characters).</div>
          </div>
          <div class="form-group">
            <label for="editPriority">Priority (Integer)</label>
            <input 
              type="number" 
              class="form-control" 
              id="editPriority" 
              name="Priority" 
              step="1"
            >
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-info"><i class="fas fa-save mr-1"></i> Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Delete Confirmation -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form id="deleteForm" method="POST">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title" id="deleteModalLabel"><i class="fas fa-exclamation-triangle mr-1"></i> Delete Confirmation</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to delete <strong id="deleteItemName"></strong>?</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger"><i class="fas fa-trash mr-1"></i> Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Required Core Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/overlayscrollbars/1.13.1/js/jquery.overlayScrollbars.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

<script>
  $(document).ready(function() {
    // Populate Edit Modal
    $('.edit-btn').on('click', function() {
      const id = $(this).data('id');
      const name = $(this).data('name');
      const priority = $(this).data('priority');

      $('#editId').val(id);
      $('#editName').val(name);
      $('#editPriority').val(priority);

      $('#editModal').modal('show');
    });

    // Populate Delete Modal
    $('.delete-btn').on('click', function() {
      const id = $(this).data('id');
      const name = $(this).data('name');

      $('#deleteItemName').text(name);
      $('#deleteForm').attr('action', '/order-code/delete/' + id);

      $('#deleteModal').modal('show');
    });

    // Form Validation logic
    $('.needs-validation').on('submit', function(e) {
      if (!this.checkValidity()) {
        e.preventDefault();
        e.stopPropagation();
      }
      $(this).addClass('was-validated');
    });
  });
</script>

</body>
</html>
