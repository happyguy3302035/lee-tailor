<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ShortForm Management</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- Theme style (AdminLTE) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
  <!-- Toastr for Notifications -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
</head>
<body class="hold-transition sidebar-mini">
<div class="wrapper">

  <!-- Navbar -->
  <%- include('partials/navbar') %>

  <!-- Main Sidebar Container -->
  <%- include('partials/sidebar', { activePage: 'shortform' }) %>

  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1>ShortForm Records</h1>
          </div>
          <div class="col-sm-6 text-right">
            <button class="btn btn-primary" onclick="openCreateModal()">
              <i class="fas fa-plus"></i> Add ShortForm
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">
        <div class="card card-outline card-primary">
          <div class="card-header">
            <h3 class="card-title">All ShortForm Entries</h3>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped table-hover mb-0" id="shortformTable">
                <thead>
                  <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Short Form</th>
                    <th>Created At</th>
                    <th>Updated At</th>
                    <th style="width: 150px;" class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (shortforms && shortforms.length > 0) { %>
                    <% shortforms.forEach(function(item) { %>
                      <tr id="row-<%= item.id %>">
                        <td><%= item.id %></td>
                        <td class="sf-value"><strong><%= item.ShortForm %></strong></td>
                        <td><%= item.createddatetime %></td>
                        <td><%= item.updateddatetime %></td>
                        <td class="text-center">
                          <button class="btn btn-sm btn-info mr-1" onclick="openEditModal(<%= item.id %>)">
                            <i class="fas fa-edit"></i>
                          </button>
                          <button class="btn btn-sm btn-danger" onclick="deleteShortForm(<%= item.id %>)">
                            <i class="fas fa-trash"></i>
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr id="emptyRow">
                      <td colspan="5" class="text-center text-muted py-4">No ShortForm records found.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Modal for Create / Edit -->
  <div class="modal fade" id="shortFormModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">Add ShortForm</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <form id="shortForm">
          <div class="modal-body">
            <input type="hidden" id="sfId" name="id">
            <div class="form-group">
              <label for="shortFormInput">Short Form Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="shortFormInput" name="shortform" placeholder="Enter shortform text" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary" id="saveBtn">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <%- include('partials/footer') %>

</div>

<!-- Required Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>
  // Open Modal for Creating
  function openCreateModal() {
    $('#sfId').val('');
    $('#shortFormInput').val('');
    $('#modalTitle').text('Add ShortForm');
    $('#shortFormModal').modal('show');
  }

  // Open Modal for Editing (Fetches detail via REST API)
  function openEditModal(id) {
    $.ajax({
      url: '/api/shortform/' + id,
      type: 'GET',
      success: function(response) {
        if (response.success && response.data) {
          $('#sfId').val(response.data.id);
          $('#shortFormInput').val(response.data.ShortForm);
          $('#modalTitle').text('Edit ShortForm #' + id);
          $('#shortFormModal').modal('show');
        } else {
          toastr.error(response.message || 'Error fetching details');
        }
      },
      error: function() {
        toastr.error('Failed to communicate with server');
      }
    });
  }

  // Handle Form Submission (Create or Update)
  $('#shortForm').on('submit', function(e) {
    e.preventDefault();
    const id = $('#sfId').val();
    const shortformVal = $('#shortFormInput').val();

    const isEdit = Boolean(id);
    const url = isEdit ? '/api/shortform/' + id : '/api/shortform';
    const method = isEdit ? 'PUT' : 'POST';

    $.ajax({
      url: url,
      type: method,
      contentType: 'application/json',
      data: JSON.stringify({ shortform: shortformVal }),
      success: function(res) {
        if (res.success) {
          toastr.success(res.message);
          $('#shortFormModal').modal('hide');
          // Reload to reflect changes from database
          setTimeout(() => window.location.reload(), 600);
        } else {
          toastr.error(res.message);
        }
      },
      error: function(err) {
        const errorMsg = err.responseJSON ? err.responseJSON.message : 'Action failed';
        toastr.error(errorMsg);
      }
    });
  });

  // Delete Record via AJAX
  function deleteShortForm(id) {
    if (confirm('Are you sure you want to delete this record?')) {
      $.ajax({
        url: '/api/shortform/' + id,
        type: 'DELETE',
        success: function(res) {
          if (res.success) {
            toastr.success(res.message);
            $('#row-' + id).fadeOut(400, function() {
              $(this).remove();
            });
          } else {
            toastr.error(res.message);
          }
        },
        error: function() {
          toastr.error('Failed to delete record.');
        }
      });
    }
  }
</script>
</body>
</html>
