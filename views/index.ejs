<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>報價單管理 - LTMS 管理系統</title>
  
  <!-- Link to static styles in /public/css/styles.css -->
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <div class="app-layout">
    
    <!-- 1. Server-Rendered Shared Menu Partial -->
    <%- include('partials/sidebar', { activePage: activePage }) %>

    <!-- 2. Main Page Content -->
    <main class="main-wrapper">
      
      <!-- Top Header -->
      <header class="page-header">
        <div class="header-title">
          <h1>報價單管理</h1>
          <p class="subtitle">檢視與管理所有報價單記錄</p>
        </div>
        <div class="user-profile">
          <span>使用者: <strong><%= user ? user.username : 'Admin' %></strong></span>
        </div>
      </header>

      <!-- Main Dashboard Content -->
      <section class="content-body">
        <div class="card">
          <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
            <h2>報價單列表</h2>
            <button class="btn btn-primary">+ 新增報價單</button>
          </div>
          
          <div class="card-content">
            <!-- Table Container -->
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>報價單編號</th>
                    <th>客戶名稱</th>
                    <th>日期</th>
                    <th>總金額 (HKD)</th>
                    <th>狀態</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  <!-- Sample row - populate dynamically via backend/database -->
                  <tr>
                    <td>QT-2026-001</td>
                    <td>範例客戶有限公司</td>
                    <td>2026-08-05</td>
                    <td>$12,500.00</td>
                    <td><span class="badge badge-success">已確認</span></td>
                    <td>
                      <a href="#" class="btn-link">檢視</a> | 
                      <a href="#" class="btn-link">編輯</a>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

    </main>

  </div>

</body>
</html>
